  "sentences": [
    {
      "id": "ro_s1",
      "en": "I wake up at six every day.",
      "ar": "أستيقظ في السادسة كل يوم.",
      "tr": "آي ويك أب آت سِكس إڤري ديه"
    },
    {
      "id": "ro_s2",
      "en": "Then I take a shower.",
      "ar": "ثم أستحم.",
      "tr": "ذِن آي تيك إيه شاوَر"
    },
    {
      "id": "ro_s3",
      "en": "I have breakfast at seven.",
      "ar": "أتناول الفطور في السابعة.",
      "tr": "آي هاڤ برِكفَست آت سِڤِن"
    },
    {
      "id": "ro_s4",
      "en": "I go to work by bus.",
      "ar": "أذهب إلى العمل بالحافلة.",
      "tr": "آي غو تو وِرك باي بَس"
    },
    {
      "id": "ro_s5",
      "en": "I come home at five.",
      "ar": "أعود إلى البيت في الخامسة.",
      "tr": "آي كَم هوم آت فايڤ"
    },
    {
      "id": "ro_s6",
      "en": "After dinner, I study English.",
      "ar": "بعد العشاء أدرس الإنجليزية.",
      "tr": "آفتَر دِنَر، آي ستَدي إنغلِش"
    },
    {
      "id": "ro_s7",
      "en": "I usually sleep at eleven.",
      "ar": "عادةً أنام في الحادية عشرة.",
      "tr": "آي يوجُوَلي سليپ آت إليڤِن"
    },
    {
      "id": "ro_s8",
      "en": "On Friday I clean the house.",
      "ar": "يوم الجمعة أنظّف البيت.",
      "tr": "أون فرايديه آي كلين ذَ هاوس"
    },
    {
      "id": "ro_s9",
      "en": "Hurry up, we are late!",
      "ar": "أسرع، نحن متأخرون!",
      "tr": "هَري أب، وي آر ليت"
    },
    {
      "id": "ro_s10",
      "en": "What do you do every morning?",
      "ar": "ماذا تفعل كل صباح؟",
      "tr": "وات دو يو دو إڤري مورنِنغ"
    },
    {
      "id": "ro_s11",
      "en": "I exercise three times a week.",
      "ar": "أمارس الرياضة ثلاث مرات في الأسبوع.",
      "tr": "آي إكسَرسايز ثري تايمز إيه ويك"
    },
    {
      "id": "ro_s12",
      "en": "I relax and watch TV in the evening.",
      "ar": "أسترخي وأشاهد التلفاز في المساء.",
      "tr": "آي رِلاكس آند واتش تي ڤي إن ذي إيفنِنغ"
    },
    {
      "id": "ro_s13",
      "en": "I set my alarm for six.",
      "ar": "أضبط المنبه على السادسة.",
      "tr": "آي سِت ماي ألارم فور سِكس"
    },
    {
      "id": "ro_s14",
      "en": "I make my bed every morning.",
      "ar": "أرتّب سريري كل صباح.",
      "tr": "آي ميك ماي بِد إڤري مورنِنغ"
    },
    {
      "id": "ro_s15",
      "en": "Then I check my phone.",
      "ar": "ثم أتفقّد هاتفي.",
      "tr": "ذِن آي تشِك ماي فون"
    },
    {
      "id": "ro_s16",
      "en": "I take the bus at seven thirty.",
      "ar": "آخذ الحافلة في السابعة والنصف.",
      "tr": "آي تيك ذَ بَس آت سِڤِن ثيرتي"
    },
    {
      "id": "ro_s17",
      "en": "I have a short break at noon.",
      "ar": "لدي استراحة قصيرة ظهراً.",
      "tr": "آي هاڤ إيه شورت بريك آت نون"
    },
    {
      "id": "ro_s18",
      "en": "After work I go shopping.",
      "ar": "بعد العمل أذهب للتسوق.",
      "tr": "آفتَر وِرك آي غو شوپِنغ"
    },
    {
      "id": "ro_s19",
      "en": "I call my mother every evening.",
      "ar": "أتصل بأمي كل مساء.",
      "tr": "آي كول ماي مَذَر إڤري إيفنِنغ"
    },
    {
      "id": "ro_s20",
      "en": "I read a little before sleeping.",
      "ar": "أقرأ قليلاً قبل النوم.",
      "tr": "آي ريد إيه لِتِل بِفور سليپِنغ"
    },
    {
      "id": "ro_s21",
      "en": "On Saturday I rest at home.",
      "ar": "يوم السبت أرتاح في البيت.",
      "tr": "أون ساتَرديه آي رِست آت هوم"
    },
    {
      "id": "ro_s22",
      "en": "I try to sleep early.",
      "ar": "أحاول النوم مبكراً.",
      "tr": "آي تراي تو سليپ إيرلي"
    }
  ]
}
