  "sentences": [
    {
      "id": "pl_s1",
      "en": "Where is the hospital?",
      "ar": "أين المستشفى؟",
      "tr": "وير إز ذَ هوسپِتَل"
    },
    {
      "id": "pl_s2",
      "en": "The bank is on this street.",
      "ar": "البنك في هذا الشارع.",
      "tr": "ذَ بانك إز أون ذِس ستريت"
    },
    {
      "id": "pl_s3",
      "en": "Is it far from here?",
      "ar": "هل هو بعيد من هنا؟",
      "tr": "إز إت فار فروم هير"
    },
    {
      "id": "pl_s4",
      "en": "It is very near.",
      "ar": "إنه قريب جداً.",
      "tr": "إت إز ڤيري نير"
    },
    {
      "id": "pl_s5",
      "en": "I live in a small village.",
      "ar": "أعيش في قرية صغيرة.",
      "tr": "آي لِڤ إن إيه سمول ڤِلِج"
    },
    {
      "id": "pl_s6",
      "en": "There is a café near the park.",
      "ar": "يوجد مقهى قرب الحديقة.",
      "tr": "ذير إز إيه كافيه نير ذَ پارك"
    },
    {
      "id": "pl_s7",
      "en": "I go to the market on Friday.",
      "ar": "أذهب إلى السوق يوم الجمعة.",
      "tr": "آي غو تو ذَ ماركِت أون فرايديه"
    },
    {
      "id": "pl_s8",
      "en": "The hotel is next to the airport.",
      "ar": "الفندق بجانب المطار.",
      "tr": "ذَ هوتيل إز نِكست تو ذي إيرپورت"
    },
    {
      "id": "pl_s9",
      "en": "Excuse me, where is the station?",
      "ar": "لو سمحت، أين المحطة؟",
      "tr": "إكسكيوز مي، وير إز ذَ ستيشِن"
    },
    {
      "id": "pl_s10",
      "en": "My school is in this city.",
      "ar": "مدرستي في هذه المدينة.",
      "tr": "ماي سكوول إز إن ذِس سِتي"
    },
    {
      "id": "pl_s11",
      "en": "Is there a pharmacy near here?",
      "ar": "هل توجد صيدلية قريبة؟",
      "tr": "إز ذير إيه فارمَسي نير هير"
    },
    {
      "id": "pl_s12",
      "en": "How do I get to the city center?",
      "ar": "كيف أصل إلى وسط المدينة؟",
      "tr": "هاو دو آي غِت تو ذَ سِتي سِنتَر"
    },
    {
      "id": "pl_s13",
      "en": "It is about ten minutes on foot.",
      "ar": "تبعد حوالي عشر دقائق مشياً.",
      "tr": "إت إز أباوت تِن مِنِتس أون فوت"
    },
    {
      "id": "pl_s14",
      "en": "I work near the big mosque.",
      "ar": "أعمل قرب المسجد الكبير.",
      "tr": "آي وِرك نير ذَ بِغ موسك"
    },
    {
      "id": "pl_s15",
      "en": "The library opens at eight.",
      "ar": "المكتبة تفتح في الثامنة.",
      "tr": "ذَ لايبرَري أوپِنز آت إيت"
    },
    {
      "id": "pl_s16",
      "en": "Let's meet at the café.",
      "ar": "لنلتقِ في المقهى.",
      "tr": "لِتس ميت آت ذَ كافيه"
    },
    {
      "id": "pl_s17",
      "en": "This street is very busy.",
      "ar": "هذا الشارع مزدحم جداً.",
      "tr": "ذِس ستريت إز ڤيري بِزي"
    },
    {
      "id": "pl_s18",
      "en": "Is it far from the station?",
      "ar": "هل هو بعيد عن المحطة؟",
      "tr": "إز إت فار فروم ذَ ستيشِن"
    }
  ]
}
