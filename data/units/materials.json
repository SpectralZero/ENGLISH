  "sentences": [
    {
      "id": "mt_s1",
      "en": "This table is made of wood.",
      "ar": "هذه الطاولة مصنوعة من الخشب.",
      "tr": "ذِس تيبِل إز ميد أوڤ وود"
    },
    {
      "id": "mt_s2",
      "en": "I prefer cotton shirts.",
      "ar": "أفضّل القمصان القطنية.",
      "tr": "آي پرِفير كوتِن شيرتس"
    },
    {
      "id": "mt_s3",
      "en": "Be careful, it is glass.",
      "ar": "انتبه، إنه زجاج.",
      "tr": "بي كيرفُل، إت إز غلاس"
    },
    {
      "id": "mt_s4",
      "en": "The bag is real leather.",
      "ar": "الحقيبة جلد حقيقي.",
      "tr": "ذَ باغ إز رِيَل لِذَر"
    },
    {
      "id": "mt_s5",
      "en": "This plastic is very thin.",
      "ar": "هذا البلاستيك رقيق جداً.",
      "tr": "ذِس پلاستِك إز ڤيري ثِن"
    },
    {
      "id": "mt_s6",
      "en": "The quality is very good.",
      "ar": "الجودة ممتازة.",
      "tr": "ذَ كوالِتي إز ڤيري غُود"
    },
    {
      "id": "mt_s7",
      "en": "The house is built of stone.",
      "ar": "البيت مبني من الحجر.",
      "tr": "ذَ هاوس إز بِلت أوڤ ستون"
    },
    {
      "id": "mt_s8",
      "en": "Wool is warm in winter.",
      "ar": "الصوف دافئ في الشتاء.",
      "tr": "وول إز وورم إن وِنتَر"
    }
  ]
