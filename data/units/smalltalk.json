  "sentences": [
    {
      "id": "sm_s1",
      "en": "Hi! Long time no see.",
      "ar": "أهلاً! لم أرك منذ زمن.",
      "tr": "هاي! لونغ تايم نو سي"
    },
    {
      "id": "sm_s2",
      "en": "How is your family?",
      "ar": "كيف حال عائلتك؟",
      "tr": "هاو إز يور فامِلي"
    },
    {
      "id": "sm_s3",
      "en": "They are fine, thank you.",
      "ar": "هم بخير، شكراً لك.",
      "tr": "ذيه آر فاين، ثانك يو"
    },
    {
      "id": "sm_s4",
      "en": "What do you do for work?",
      "ar": "ماذا تعمل؟",
      "tr": "وات دو يو دو فور وِرك"
    },
    {
      "id": "sm_s5",
      "en": "I have been here for two years.",
      "ar": "أنا هنا منذ سنتين.",
      "tr": "آيڤ بين هير فور تو يِيرز"
    },
    {
      "id": "sm_s6",
      "en": "That's great news!",
      "ar": "هذه أخبار رائعة!",
      "tr": "ذاتس غريت نيوز"
    },
    {
      "id": "sm_s7",
      "en": "By the way, where do you live?",
      "ar": "بالمناسبة، أين تسكن؟",
      "tr": "باي ذَ ويه، وير دو يو لِڤ"
    },
    {
      "id": "sm_s8",
      "en": "Sorry, I have to go now.",
      "ar": "آسف، يجب أن أذهب الآن.",
      "tr": "سوري، آي هاڤ تو غو ناو"
    },
    {
      "id": "sm_s9",
      "en": "It was nice talking to you.",
      "ar": "سُررت بالحديث معك.",
      "tr": "إت واز نايس توكِنغ تو يو"
    },
    {
      "id": "sm_s10",
      "en": "Take care, see you soon.",
      "ar": "اعتنِ بنفسك، أراك قريباً.",
      "tr": "تيك كير، سي يو سون"
    },
    {
      "id": "sm_s11",
      "en": "Can I have your phone number?",
      "ar": "هل يمكنني أخذ رقم هاتفك؟",
      "tr": "كان آي هاڤ يور فون نَمبَر"
    },
    {
      "id": "sm_s12",
      "en": "You are welcome at my home any time.",
      "ar": "أهلاً بك في بيتي في أي وقت.",
      "tr": "يو آر وِلكَم آت ماي هوم إني تايم"
    },
    {
      "id": "sm_s13",
      "en": "Say hello to your brother.",
      "ar": "سلّم على أخيك.",
      "tr": "سيه هَلو تو يور براذَر"
    },
    {
      "id": "sm_s14",
      "en": "Let's meet tomorrow evening.",
      "ar": "لنلتقِ مساء الغد.",
      "tr": "لِتس ميت تُومورو إيفنِنغ"
    },
    {
      "id": "sm_s15",
      "en": "Do you live around here?",
      "ar": "هل تسكن في هذه المنطقة؟",
      "tr": "دو يو لِڤ أراوند هير"
    },
    {
      "id": "sm_s16",
      "en": "How was your weekend?",
      "ar": "كيف كانت عطلتك؟",
      "tr": "هاو واز يور ويكِند"
    },
    {
      "id": "sm_s17",
      "en": "It was quiet, thank God.",
      "ar": "كانت هادئة، الحمد لله.",
      "tr": "إت واز كوايَت، ثانك غود"
    },
    {
      "id": "sm_s18",
      "en": "That sounds interesting.",
      "ar": "يبدو ذلك مثيراً للاهتمام.",
      "tr": "ذات ساوندز إنتِرِستِنغ"
    },
    {
      "id": "sm_s19",
      "en": "I have heard a lot about you.",
      "ar": "سمعت الكثير عنك.",
      "tr": "آيڤ هيرد إيه لوت أباوت يو"
    },
    {
      "id": "sm_s20",
      "en": "We should meet more often.",
      "ar": "يجب أن نلتقي أكثر.",
      "tr": "وي شود ميت مور أوفِن"
    },
    {
      "id": "sm_s21",
      "en": "Give me a call when you arrive.",
      "ar": "اتصل بي عندما تصل.",
      "tr": "غِڤ مي إيه كول وِن يو أرايڤ"
    },
    {
      "id": "sm_s22",
      "en": "Thank you for coming.",
      "ar": "شكراً لحضورك.",
      "tr": "ثانك يو فور كَمِنغ"
    }
  ]
}
