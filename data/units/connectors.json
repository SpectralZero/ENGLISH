  "sentences": [
    {
      "id": "cnn_s1",
      "en": "I was tired, so I went home.",
      "ar": "كنت متعباً، لذلك ذهبت إلى البيت.",
      "tr": "آي واز تايَرد، سو آي وِنت هوم"
    },
    {
      "id": "cnn_s2",
      "en": "I like tea but not coffee.",
      "ar": "أحب الشاي لكن ليس القهوة.",
      "tr": "آي لايك تي بَت نوت كوفي"
    },
    {
      "id": "cnn_s3",
      "en": "If it rains, we will stay home.",
      "ar": "إذا أمطرت، سنبقى في البيت.",
      "tr": "إف إت رينز، وي وِل ستيه هوم"
    },
    {
      "id": "cnn_s4",
      "en": "I called you because I needed help.",
      "ar": "اتصلت بك لأنني احتجت المساعدة.",
      "tr": "آي كولد يو بِكوز آي نيدِد هِلپ"
    },
    {
      "id": "cnn_s5",
      "en": "First of all, thank you for coming.",
      "ar": "أولاً، شكراً لحضورك.",
      "tr": "فيرست أوڤ أول، ثانك يو فور كَمِنغ"
    },
    {
      "id": "cnn_s6",
      "en": "I have already eaten, thanks.",
      "ar": "لقد أكلت بالفعل، شكراً.",
      "tr": "آي هاڤ أولرِدي إيتِن، ثانكس"
    },
    {
      "id": "cnn_s7",
      "en": "He usually arrives at eight.",
      "ar": "هو عادةً يصل في الثامنة.",
      "tr": "هي يوجُوَلي أرايڤز آت إيت"
    },
    {
      "id": "cnn_s8",
      "en": "Please speak more slowly.",
      "ar": "من فضلك تكلم ببطء أكثر.",
      "tr": "پليز سپيك مور سلولي"
    },
    {
      "id": "cnn_s9",
      "en": "I have never been there.",
      "ar": "لم أذهب إلى هناك أبداً.",
      "tr": "آي هاڤ نِڤَر بين ذير"
    },
    {
      "id": "cnn_s10",
      "en": "Although it was late, he came.",
      "ar": "رغم أن الوقت كان متأخراً، أتى.",
      "tr": "أولذو إت واز ليت، هي كيم"
    }
  ]
