  "sentences": [
    {
      "id": "un_s1",
      "en": "I study at the university.",
      "ar": "أدرس في الجامعة.",
      "tr": "آي ستَدي آت ذَ يونِڤيرسِتي"
    },
    {
      "id": "un_s2",
      "en": "The lecture starts at nine.",
      "ar": "المحاضرة تبدأ في التاسعة.",
      "tr": "ذَ لِكتشَر ستارتس آت ناين"
    },
    {
      "id": "un_s3",
      "en": "I have an essay to finish.",
      "ar": "لدي مقال يجب أن أنهيه.",
      "tr": "آي هاڤ آن إسيه تو فِنِش"
    },
    {
      "id": "un_s4",
      "en": "Can I borrow your notes?",
      "ar": "هل يمكنني استعارة ملاحظاتك؟",
      "tr": "كان آي بورو يور نوتس"
    },
    {
      "id": "un_s5",
      "en": "The deadline is on Sunday.",
      "ar": "موعد التسليم يوم الأحد.",
      "tr": "ذَ دِدلاين إز أون سَنديه"
    },
    {
      "id": "un_s6",
      "en": "I passed all my subjects.",
      "ar": "نجحت في كل موادي.",
      "tr": "آي پاست أول ماي سَبجِكتس"
    },
    {
      "id": "un_s7",
      "en": "This subject is difficult for me.",
      "ar": "هذه المادة صعبة عليّ.",
      "tr": "ذِس سَبجِكت إز دِفِكَلت فور مي"
    },
    {
      "id": "un_s8",
      "en": "I want to graduate next year.",
      "ar": "أريد التخرج العام القادم.",
      "tr": "آي وانت تو غراجُويت نِكست يِير"
    },
    {
      "id": "un_s9",
      "en": "Could you explain that again?",
      "ar": "هل يمكنك شرح ذلك مرة أخرى؟",
      "tr": "كود يو إكسپلين ذات أغين"
    },
    {
      "id": "un_s10",
      "en": "I study better in the library.",
      "ar": "أدرس بشكل أفضل في المكتبة.",
      "tr": "آي ستَدي بِتَر إن ذَ لايبرَري"
    }
  ]
}
