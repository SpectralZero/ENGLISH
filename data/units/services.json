  "sentences": [
    {
      "id": "sv_s1",
      "en": "I need to renew my residence.",
      "ar": "أحتاج تجديد إقامتي.",
      "tr": "آي نيد تو رِنيو ماي رِزِدَنس"
    },
    {
      "id": "sv_s2",
      "en": "My passport is expired.",
      "ar": "جواز سفري منتهي الصلاحية.",
      "tr": "ماي پاسپورت إز إكسپايَرد"
    },
    {
      "id": "sv_s3",
      "en": "Do I need an appointment?",
      "ar": "هل أحتاج موعداً؟",
      "tr": "دو آي نيد آن أپوينتمِنت"
    },
    {
      "id": "sv_s4",
      "en": "Please take a queue number.",
      "ar": "من فضلك خذ رقم دور.",
      "tr": "پليز تيك إيه كيو نَمبَر"
    },
    {
      "id": "sv_s5",
      "en": "Go to the next window, please.",
      "ar": "اذهب إلى الشباك التالي من فضلك.",
      "tr": "غو تو ذَ نِكست وِندو، پليز"
    },
    {
      "id": "sv_s6",
      "en": "I brought the original and a copy.",
      "ar": "أحضرت الأصل ونسخة.",
      "tr": "آي بروت ذي أُرِجِنَل آند إيه كوپي"
    },
    {
      "id": "sv_s7",
      "en": "How much is the fee?",
      "ar": "كم الرسوم؟",
      "tr": "هاو مَتش إز ذَ في"
    },
    {
      "id": "sv_s8",
      "en": "Can you help me fill this form?",
      "ar": "هل يمكنك مساعدتي في تعبئة هذه الاستمارة؟",
      "tr": "كان يو هِلپ مي فِل ذِس فورم"
    },
    {
      "id": "sv_s9",
      "en": "The office is closed today.",
      "ar": "الدائرة مغلقة اليوم.",
      "tr": "ذي أوفِس إز كلوزد تُوديه"
    },
    {
      "id": "sv_s10",
      "en": "When will it be ready?",
      "ar": "متى ستكون جاهزة؟",
      "tr": "وِن وِل إت بي رِدي"
    }
  ]
}
