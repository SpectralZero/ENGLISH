  "sentences": [
    {
      "id": "ki_s1",
      "en": "I am cooking dinner now.",
      "ar": "أنا أطبخ العشاء الآن.",
      "tr": "آيم كوكِنغ دِنَر ناو"
    },
    {
      "id": "ki_s2",
      "en": "Boil the water first.",
      "ar": "اغلِ الماء أولاً.",
      "tr": "بويل ذَ ووتَر فيرست"
    },
    {
      "id": "ki_s3",
      "en": "Add a little salt and pepper.",
      "ar": "أضف قليلاً من الملح والفلفل.",
      "tr": "آد إيه لِتِل سولت آند پِپَر"
    },
    {
      "id": "ki_s4",
      "en": "The food is in the oven.",
      "ar": "الطعام في الفرن.",
      "tr": "ذَ فوود إز إن ذي أوڤِن"
    },
    {
      "id": "ki_s5",
      "en": "Can you help me in the kitchen?",
      "ar": "هل يمكنك مساعدتي في المطبخ؟",
      "tr": "كان يو هِلپ مي إن ذَ كِتشِن"
    },
    {
      "id": "ki_s6",
      "en": "This recipe is very easy.",
      "ar": "هذه الوصفة سهلة جداً.",
      "tr": "ذِس رِسِپي إز ڤيري إيزي"
    },
    {
      "id": "ki_s7",
      "en": "Be careful, the pan is hot.",
      "ar": "انتبه، المقلاة ساخنة.",
      "tr": "بي كيرفُل، ذَ پان إز هوت"
    },
    {
      "id": "ki_s8",
      "en": "I wash the dishes every night.",
      "ar": "أغسل الصحون كل ليلة.",
      "tr": "آي واش ذَ دِشِز إڤري نايت"
    },
    {
      "id": "ki_s9",
      "en": "Put the milk in the fridge.",
      "ar": "ضع الحليب في الثلاجة.",
      "tr": "پوت ذَ مِلك إن ذَ فرِدج"
    },
    {
      "id": "ki_s10",
      "en": "Taste it and tell me.",
      "ar": "تذوقه وأخبرني.",
      "tr": "تيست إت آند تِل مي"
    },
    {
      "id": "ki_s11",
      "en": "Cut the onions into small pieces.",
      "ar": "قطّع البصل إلى قطع صغيرة.",
      "tr": "كَت ذي أنيَنز إنتو سمول پيسِز"
    },
    {
      "id": "ki_s12",
      "en": "Don't forget to turn off the stove.",
      "ar": "لا تنسَ إطفاء الموقد.",
      "tr": "دونت فَرغِت تو تيرن أوف ذَ ستوڤ"
    },
    {
      "id": "ki_s13",
      "en": "It needs ten more minutes.",
      "ar": "يحتاج عشر دقائق أخرى.",
      "tr": "إت نيدز تِن مور مِنِتس"
    },
    {
      "id": "ki_s14",
      "en": "Mix everything together.",
      "ar": "اخلط كل شيء معاً.",
      "tr": "مِكس إڤريثِنغ تُوغيذَر"
    },
    {
      "id": "ki_s15",
      "en": "The rice is ready.",
      "ar": "الأرز جاهز.",
      "tr": "ذَ رايس إز رِدي"
    },
    {
      "id": "ki_s16",
      "en": "Keep the leftovers in the fridge.",
      "ar": "احفظ البقايا في الثلاجة.",
      "tr": "كيپ ذَ لِفت أوڤَرز إن ذَ فرِدج"
    },
    {
      "id": "ki_s17",
      "en": "Can you pass me the salt?",
      "ar": "هل يمكنك مناولتي الملح؟",
      "tr": "كان يو پاس مي ذَ سولت"
    },
    {
      "id": "ki_s18",
      "en": "I burned the food a little.",
      "ar": "أحرقت الطعام قليلاً.",
      "tr": "آي بيرند ذَ فوود إيه لِتِل"
    }
  ]
}
