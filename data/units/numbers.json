  "sentences": [
    {
      "id": "nu_s1",
      "en": "I have three children.",
      "ar": "لدي ثلاثة أطفال.",
      "tr": "آي هاڤ ثري تشِلدرِن"
    },
    {
      "id": "nu_s2",
      "en": "How many books do you have?",
      "ar": "كم كتاباً لديك؟",
      "tr": "هاو مِني بوكس دو يو هاڤ"
    },
    {
      "id": "nu_s3",
      "en": "My number is five, six, seven.",
      "ar": "رقمي خمسة، ستة، سبعة.",
      "tr": "ماي نَمبَر إز فايڤ، سِكس، سِڤِن"
    },
    {
      "id": "nu_s4",
      "en": "I am thirty years old.",
      "ar": "عمري ثلاثون سنة.",
      "tr": "آي آم ثِرتي يِيرز أولد"
    },
    {
      "id": "nu_s5",
      "en": "Give me two, please.",
      "ar": "أعطني اثنين من فضلك.",
      "tr": "غِڤ مي تو، پليز"
    },
    {
      "id": "nu_s6",
      "en": "There are twenty students here.",
      "ar": "يوجد عشرون طالباً هنا.",
      "tr": "ذير آر تْوِنتي ستيودِنتس هير"
    },
    {
      "id": "nu_s7",
      "en": "It costs fifty pounds.",
      "ar": "ثمنها خمسون جنيهاً.",
      "tr": "إت كوستس فِفتي پاوندز"
    },
    {
      "id": "nu_s8",
      "en": "This is my first lesson.",
      "ar": "هذا درسي الأول.",
      "tr": "ذِس إز ماي فيرست لِسِن"
    },
    {
      "id": "nu_s9",
      "en": "I need four tickets, please.",
      "ar": "أحتاج أربع تذاكر من فضلك.",
      "tr": "آي نيد فور تِكِتس، پليز"
    },
    {
      "id": "nu_s10",
      "en": "The room number is twelve.",
      "ar": "رقم الغرفة اثنا عشر.",
      "tr": "ذَ روم نَمبَر إز تْوِلڤ"
    },
    {
      "id": "nu_s11",
      "en": "It takes about fifteen minutes.",
      "ar": "يستغرق حوالي خمس عشرة دقيقة.",
      "tr": "إت تيكس أباوت فِفتين مِنِتس"
    },
    {
      "id": "nu_s12",
      "en": "I have only one hundred left.",
      "ar": "لم يبقَ معي سوى مئة.",
      "tr": "آي هاڤ أونلي وان هَندرِد لِفت"
    },
    {
      "id": "nu_s13",
      "en": "Count from one to ten.",
      "ar": "عُدّ من واحد إلى عشرة.",
      "tr": "كاونت فروم وان تو تِن"
    },
    {
      "id": "nu_s14",
      "en": "I work eight hours a day.",
      "ar": "أعمل ثماني ساعات يومياً.",
      "tr": "آي وِرك إيت آوَرز إيه ديه"
    },
    {
      "id": "nu_s15",
      "en": "Give me half of it.",
      "ar": "أعطني نصفه.",
      "tr": "غِڤ مي هاف أوڤ إت"
    },
    {
      "id": "nu_s16",
      "en": "There are more than twenty.",
      "ar": "يوجد أكثر من عشرين.",
      "tr": "ذير آر مور ذان تْوِنتي"
    }
