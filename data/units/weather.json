    { "id": "we_s1", "en": "How is the weather today?", "ar": "كيف الطقس اليوم؟", "tr": "هاو إز ذَ وِذَر تُوديه" },
    { "id": "we_s2", "en": "It is very hot in summer.", "ar": "الجو حار جداً في الصيف.", "tr": "إت إز ڤيري هوت إن سَمَر" },
    { "id": "we_s3", "en": "It is raining now.", "ar": "إنها تمطر الآن.", "tr": "إت إز رينِنغ ناو" },
    { "id": "we_s4", "en": "The sky is clear today.", "ar": "السماء صافية اليوم.", "tr": "ذَ سكاي إز كلير تُوديه" },
    { "id": "we_s5", "en": "I like winter more than summer.", "ar": "أحب الشتاء أكثر من الصيف.", "tr": "آي لايك وِنتَر مور ذان سَمَر" },
    { "id": "we_s6", "en": "There is a lot of wind.", "ar": "توجد رياح كثيرة.", "tr": "ذير إز إيه لوت أوڤ وِند" },
    { "id": "we_s7", "en": "We go to the sea in summer.", "ar": "نذهب إلى البحر في الصيف.", "tr": "وي غو تو ذَ سي إن سَمَر" },
    { "id": "we_s8", "en": "The moon is beautiful tonight.", "ar": "القمر جميل هذه الليلة.", "tr": "ذَ مون إز بيوتِفُل تُونايت" },
