  "sentences": [
    {
      "id": "tv_s1",
      "en": "Where is gate number five?",
      "ar": "أين البوابة رقم خمسة؟",
      "tr": "وير إز غيت نَمبَر فايڤ"
    },
    {
      "id": "tv_s2",
      "en": "My flight is at ten o'clock.",
      "ar": "رحلتي في الساعة العاشرة.",
      "tr": "ماي فلايت إز آت تِن أوكلوك"
    },
    {
      "id": "tv_s3",
      "en": "Here is my passport.",
      "ar": "تفضل جواز سفري.",
      "tr": "هير إز ماي پاسپورت"
    },
    {
      "id": "tv_s4",
      "en": "I need a room for two nights.",
      "ar": "أحتاج غرفة لليلتين.",
      "tr": "آي نيد إيه روم فور تو نايتس"
    },
    {
      "id": "tv_s5",
      "en": "I am here on holiday.",
      "ar": "أنا هنا في عطلة.",
      "tr": "آيم هير أون هولِديه"
    },
    {
      "id": "tv_s6",
      "en": "Excuse me, I am lost.",
      "ar": "لو سمحت، أنا تائه.",
      "tr": "إكسكيوز مي، آيم لوست"
    },
    {
      "id": "tv_s7",
      "en": "How can I go to the city center?",
      "ar": "كيف أذهب إلى وسط المدينة؟",
      "tr": "هاو كان آي غو تو ذَ سِتي سِنتَر"
    },
    {
      "id": "tv_s8",
      "en": "Can I take a photo here?",
      "ar": "هل يمكنني التقاط صورة هنا؟",
      "tr": "كان آي تيك إيه فوتو هير"
    },
    {
      "id": "tv_s9",
      "en": "I want to change money.",
      "ar": "أريد صرف نقود.",
      "tr": "آي وانت تو تشينج مَني"
    },
    {
      "id": "tv_s10",
      "en": "What time do we arrive?",
      "ar": "متى نصل؟",
      "tr": "وات تايم دو وي أرايڤ"
    },
    {
      "id": "tv_s11",
      "en": "Is this seat free?",
      "ar": "هل هذا المقعد فارغ؟",
      "tr": "إز ذِس سيت فري"
    },
    {
      "id": "tv_s12",
      "en": "Please call the police.",
      "ar": "من فضلك اتصل بالشرطة.",
      "tr": "پليز كول ذَ پُوليس"
    },
    {
      "id": "tv_s13",
      "en": "Is this the right gate?",
      "ar": "هل هذه البوابة الصحيحة؟",
      "tr": "إز ذِس ذَ رايت غيت"
    },
    {
      "id": "tv_s14",
      "en": "My luggage is missing.",
      "ar": "حقيبتي مفقودة.",
      "tr": "ماي لَغِج إز مِسِنغ"
    },
    {
      "id": "tv_s15",
      "en": "How long is the flight?",
      "ar": "كم مدة الرحلة؟",
      "tr": "هاو لونغ إز ذَ فلايت"
    },
    {
      "id": "tv_s16",
      "en": "I have nothing to declare.",
      "ar": "ليس لدي ما أصرّح عنه.",
      "tr": "آي هاڤ نَثِنغ تو دِكلير"
    },
    {
      "id": "tv_s17",
      "en": "Where can I get a taxi?",
      "ar": "أين أجد سيارة أجرة؟",
      "tr": "وير كان آي غِت إيه تاكسي"
    },
    {
      "id": "tv_s18",
      "en": "I booked a room for tonight.",
      "ar": "حجزت غرفة لهذه الليلة.",
      "tr": "آي بوكد إيه روم فور تُونايت"
    },
    {
      "id": "tv_s19",
      "en": "What time is check-out?",
      "ar": "متى موعد المغادرة؟",
      "tr": "وات تايم إز تشِك أوت"
    },
    {
      "id": "tv_s20",
      "en": "Is breakfast included?",
      "ar": "هل الفطور مشمول؟",
      "tr": "إز برِكفَست إنكلودِد"
    },
    {
      "id": "tv_s21",
      "en": "Can you show me on the map?",
      "ar": "هل يمكنك أن ترينِي على الخريطة؟",
      "tr": "كان يو شو مي أون ذَ ماپ"
    },
    {
      "id": "tv_s22",
      "en": "I am travelling alone.",
      "ar": "أنا مسافر وحدي.",
      "tr": "آيم تراڤِلِنغ ألون"
    }
  ]
