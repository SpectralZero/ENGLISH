  "sentences": [
    {
      "id": "bo_s1",
      "en": "I am sick today.",
      "ar": "أنا مريض اليوم.",
      "tr": "آي آم سِك تُوديه"
    },
    {
      "id": "bo_s2",
      "en": "My head hurts a lot.",
      "ar": "رأسي يؤلمني كثيراً.",
      "tr": "ماي هِد هيرتس إيه لوت"
    },
    {
      "id": "bo_s3",
      "en": "I need a doctor, please.",
      "ar": "أحتاج طبيباً من فضلك.",
      "tr": "آي نيد إيه دُكتَر، پليز"
    },
    {
      "id": "bo_s4",
      "en": "Where is the pharmacy?",
      "ar": "أين الصيدلية؟",
      "tr": "وير إز ذَ فارمَسي"
    },
    {
      "id": "bo_s5",
      "en": "Take this medicine twice a day.",
      "ar": "خذ هذا الدواء مرتين في اليوم.",
      "tr": "تيك ذِس مِدِسِن تْوايس إيه ديه"
    },
    {
      "id": "bo_s6",
      "en": "I have a fever.",
      "ar": "لدي حمى.",
      "tr": "آي هاڤ إيه فيڤَر"
    },
    {
      "id": "bo_s7",
      "en": "Wash your hands with soap.",
      "ar": "اغسل يديك بالصابون.",
      "tr": "واش يور هاندز وِذ سوپ"
    },
    {
      "id": "bo_s8",
      "en": "I feel better now.",
      "ar": "أشعر بتحسن الآن.",
      "tr": "آي فيل بِتَر ناو"
    },
    {
      "id": "bo_s9",
      "en": "You must rest and sleep.",
      "ar": "يجب أن ترتاح وتنام.",
      "tr": "يو مَست رِست آند سليپ"
    },
    {
      "id": "bo_s10",
      "en": "My back hurts when I sit.",
      "ar": "ظهري يؤلمني عندما أجلس.",
      "tr": "ماي باك هيرتس وِن آي سِت"
    },
    {
      "id": "bo_s11",
      "en": "I have a headache.",
      "ar": "عندي صداع.",
      "tr": "آي هاڤ إيه هِدإيك"
    },
    {
      "id": "bo_s12",
      "en": "My throat hurts.",
      "ar": "حلقي يؤلمني.",
      "tr": "ماي ثروت هيرتس"
    },
    {
      "id": "bo_s13",
      "en": "I need to see a doctor today.",
      "ar": "أحتاج لرؤية طبيب اليوم.",
      "tr": "آي نيد تو سي إيه دُكتَر تُوديه"
    },
    {
      "id": "bo_s14",
      "en": "Open your mouth, please.",
      "ar": "افتح فمك من فضلك.",
      "tr": "أوپِن يور ماوث، پليز"
    },
    {
      "id": "bo_s15",
      "en": "I am allergic to this medicine.",
      "ar": "لدي حساسية من هذا الدواء.",
      "tr": "آيم أليرجِك تو ذِس مِدِسِن"
    },
    {
      "id": "bo_s16",
      "en": "Drink water and rest.",
      "ar": "اشرب الماء واسترح.",
      "tr": "درِنك ووتَر آند رِست"
    },
    {
      "id": "bo_s17",
      "en": "How long have you been sick?",
      "ar": "منذ متى وأنت مريض؟",
      "tr": "هاو لونغ هاڤ يو بين سِك"
    },
    {
      "id": "bo_s18",
      "en": "I feel much better today.",
      "ar": "أشعر بتحسن كبير اليوم.",
      "tr": "آي فيل مَتش بِتَر تُوديه"
    },
    {
      "id": "bo_s19",
      "en": "He broke his arm.",
      "ar": "كسر ذراعه.",
      "tr": "هي بروك هِز آرم"
    },
    {
      "id": "bo_s20",
      "en": "Take this pill after food.",
      "ar": "خذ هذه الحبة بعد الأكل.",
      "tr": "تيك ذِس پِل آفتَر فوود"
    }
  ]
}
