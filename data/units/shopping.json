  "sentences": [
    {
      "id": "sh_s1",
      "en": "How much is this, please?",
      "ar": "بكم هذا من فضلك؟",
      "tr": "هاو مَتش إز ذِس، پليز"
    },
    {
      "id": "sh_s2",
      "en": "It is too expensive.",
      "ar": "إنه غالٍ جداً.",
      "tr": "إت إز تو إكسپِنسِڤ"
    },
    {
      "id": "sh_s3",
      "en": "Do you have a smaller size?",
      "ar": "هل لديك مقاس أصغر؟",
      "tr": "دو يو هاڤ إيه سمولَر سايز"
    },
    {
      "id": "sh_s4",
      "en": "I want two, please.",
      "ar": "أريد اثنين من فضلك.",
      "tr": "آي وانت تو، پليز"
    },
    {
      "id": "sh_s5",
      "en": "Can I pay by card?",
      "ar": "هل يمكنني الدفع بالبطاقة؟",
      "tr": "كان آي پيه باي كارد"
    },
    {
      "id": "sh_s6",
      "en": "Here is your change.",
      "ar": "تفضل الباقي.",
      "tr": "هير إز يور تشينج"
    },
    {
      "id": "sh_s7",
      "en": "The shop is closed now.",
      "ar": "المتجر مغلق الآن.",
      "tr": "ذَ شوپ إز كلوزد ناو"
    },
    {
      "id": "sh_s8",
      "en": "I am just looking, thank you.",
      "ar": "أنا فقط أتفرج، شكراً.",
      "tr": "آيم جَست لوكِنغ، ثانك يو"
    },
    {
      "id": "sh_s9",
      "en": "Is there a discount?",
      "ar": "هل يوجد خصم؟",
      "tr": "إز ذير إيه دِسكاونت"
    },
    {
      "id": "sh_s10",
      "en": "I need a bag, please.",
      "ar": "أحتاج كيساً من فضلك.",
      "tr": "آي نيد إيه باغ، پليز"
    },
    {
      "id": "sh_s11",
      "en": "I don't have enough money.",
      "ar": "ليس لدي مال كافٍ.",
      "tr": "آي دونت هاڤ إينَف مَني"
    },
    {
      "id": "sh_s12",
      "en": "Give me the receipt, please.",
      "ar": "أعطني الإيصال من فضلك.",
      "tr": "غِڤ مي ذَ رِسيت، پليز"
    },
    {
      "id": "sh_s13",
      "en": "Can I look around first?",
      "ar": "هل يمكنني التفرج أولاً؟",
      "tr": "كان آي لوك أراوند فيرست"
    },
    {
      "id": "sh_s14",
      "en": "Do you have another colour?",
      "ar": "هل لديك لون آخر؟",
      "tr": "دو يو هاڤ أناذَر كَلَر"
    },
    {
      "id": "sh_s15",
      "en": "That is too much for me.",
      "ar": "هذا كثير بالنسبة لي.",
      "tr": "ذات إز تو مَتش فور مي"
    },
    {
      "id": "sh_s16",
      "en": "Can you give me a better price?",
      "ar": "هل يمكنك إعطائي سعراً أفضل؟",
      "tr": "كان يو غِڤ مي إيه بِتَر پرايس"
    },
    {
      "id": "sh_s17",
      "en": "I will take this one.",
      "ar": "سآخذ هذا.",
      "tr": "آي وِل تيك ذِس وان"
    },
    {
      "id": "sh_s18",
      "en": "Where do I pay?",
      "ar": "أين أدفع؟",
      "tr": "وير دو آي پيه"
    },
    {
      "id": "sh_s19",
      "en": "Keep the change.",
      "ar": "احتفظ بالباقي.",
      "tr": "كيپ ذَ تشينج"
    },
    {
      "id": "sh_s20",
      "en": "Do you accept cards?",
      "ar": "هل تقبلون البطاقات؟",
      "tr": "دو يو أكسِپت كاردز"
    },
    {
      "id": "sh_s21",
      "en": "I need a receipt, please.",
      "ar": "أحتاج إيصالاً من فضلك.",
      "tr": "آي نيد إيه رِسيت، پليز"
    },
    {
      "id": "sh_s22",
      "en": "It is on sale today.",
      "ar": "إنه بتخفيض اليوم.",
      "tr": "إت إز أون سيل تُوديه"
    }
  ]
}
