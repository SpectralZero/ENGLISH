  "sentences": [
    {
      "id": "tl_s1",
      "en": "Can you lend me a hammer?",
      "ar": "هل يمكنك إعارتي مطرقة؟",
      "tr": "كان يو لِند مي إيه هامَر"
    },
    {
      "id": "tl_s2",
      "en": "I need to fix the door.",
      "ar": "أحتاج إصلاح الباب.",
      "tr": "آي نيد تو فِكس ذَ دور"
    },
    {
      "id": "tl_s3",
      "en": "Be careful, the knife is sharp.",
      "ar": "انتبه، السكين حادة.",
      "tr": "بي كيرفُل، ذَ نايف إز شارپ"
    },
    {
      "id": "tl_s4",
      "en": "This box is too heavy for me.",
      "ar": "هذا الصندوق ثقيل عليّ.",
      "tr": "ذِس بوكس إز تو هيڤي فور مي"
    },
    {
      "id": "tl_s5",
      "en": "Hold the ladder, please.",
      "ar": "أمسك السلم من فضلك.",
      "tr": "هولد ذَ لادَر، پليز"
    },
    {
      "id": "tl_s6",
      "en": "The switch is not working.",
      "ar": "مفتاح الكهرباء لا يعمل.",
      "tr": "ذَ سوِتش إز نوت وِركِنغ"
    },
    {
      "id": "tl_s7",
      "en": "Where are my gloves?",
      "ar": "أين قفازاتي؟",
      "tr": "وير آر ماي غلَڤز"
    },
    {
      "id": "tl_s8",
      "en": "Put on your helmet first.",
      "ar": "ارتدِ الخوذة أولاً.",
      "tr": "پوت أون يور هِلمِت فيرست"
    },
    {
      "id": "tl_s9",
      "en": "We will paint the wall tomorrow.",
      "ar": "سندهن الجدار غداً.",
      "tr": "وي وِل پينت ذَ وول تُومورو"
    },
    {
      "id": "tl_s10",
      "en": "I broke it by mistake.",
      "ar": "كسرته بالخطأ.",
      "tr": "آي بروك إت باي مِستيك"
    }
  ]
}
