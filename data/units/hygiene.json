  "sentences": [
    {
      "id": "hy_s1",
      "en": "Wash your hands before eating.",
      "ar": "اغسل يديك قبل الأكل.",
      "tr": "واش يور هاندز بِفور إيتِنغ"
    },
    {
      "id": "hy_s2",
      "en": "I take a shower every morning.",
      "ar": "أستحم كل صباح.",
      "tr": "آي تيك إيه شاوَر إڤري مورنِنغ"
    },
    {
      "id": "hy_s3",
      "en": "Do you have any soap?",
      "ar": "هل لديك صابون؟",
      "tr": "دو يو هاڤ إني سوپ"
    },
    {
      "id": "hy_s4",
      "en": "The towel is wet.",
      "ar": "المنشفة مبللة.",
      "tr": "ذَ تاوِل إز وِت"
    },
    {
      "id": "hy_s5",
      "en": "I brush my teeth twice a day.",
      "ar": "أنظف أسناني مرتين يومياً.",
      "tr": "آي برَش ماي تيث تْوايس إيه ديه"
    },
    {
      "id": "hy_s6",
      "en": "Please put the rubbish in the bin.",
      "ar": "ضع القمامة في السلة من فضلك.",
      "tr": "پليز پوت ذَ رَبِش إن ذَ بِن"
    },
    {
      "id": "hy_s7",
      "en": "I need a haircut.",
      "ar": "أحتاج قص شعر.",
      "tr": "آي نيد إيه هيركَت"
    },
    {
      "id": "hy_s8",
      "en": "This room is very tidy.",
      "ar": "هذه الغرفة مرتبة جداً.",
      "tr": "ذِس روم إز ڤيري تايدي"
    },
    {
      "id": "hy_s9",
      "en": "I do the laundry on Friday.",
      "ar": "أغسل الملابس يوم الجمعة.",
      "tr": "آي دو ذَ لوندري أون فرايديه"
    },
    {
      "id": "hy_s10",
      "en": "Keeping clean keeps you healthy.",
      "ar": "النظافة تحافظ على صحتك.",
      "tr": "كيپِنغ كلين كيپس يو هِلثي"
    }
  ]
