    { "id": "jo_s4", "en": "I start work at eight o'clock.", "ar": "أبدأ العمل في الثامنة.", "tr": "آي ستارت وِرك آت إيت أوكلوك" },
    { "id": "jo_s5", "en": "My office is near my house.", "ar": "مكتبي قريب من بيتي.", "tr": "ماي أوفِس إز نير ماي هاوس" },
    { "id": "jo_s6", "en": "I am looking for a job.", "ar": "أبحث عن عمل.", "tr": "آيم لوكِنغ فور إيه جوب" },
    { "id": "jo_s7", "en": "My manager is very kind.", "ar": "مديري لطيف جداً.", "tr": "ماي مانِجَر إز ڤيري كايند" },
    { "id": "jo_s8", "en": "I am busy now, sorry.", "ar": "أنا مشغول الآن، آسف.", "tr": "آيم بِزي ناو، سوري" },
