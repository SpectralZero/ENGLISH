  "sentences": [
    { "id": "ti_s1", "en": "What time is it now?", "ar": "كم الساعة الآن؟", "tr": "وات تايم إز إت ناو" },
    { "id": "ti_s2", "en": "It is seven o'clock.", "ar": "الساعة السابعة.", "tr": "إت إز سِڤِن أوكلوك" },
    { "id": "ti_s3", "en": "Today is Friday.", "ar": "اليوم هو الجمعة.", "tr": "تُوديه إز فرايديه" },
    { "id": "ti_s4", "en": "I get up early every day.", "ar": "أستيقظ مبكراً كل يوم.", "tr": "آي غِت أب إيرلي إڤري ديه" },
    { "id": "ti_s5", "en": "See you in the evening.", "ar": "أراك في المساء.", "tr": "سي يو إن ذي إيفنِنغ" },
    { "id": "ti_s6", "en": "I am free tomorrow.", "ar": "أنا متفرغ غداً.", "tr": "آي آم فري تُومورو" },
    { "id": "ti_s7", "en": "The class starts at eight.", "ar": "الحصة تبدأ في الثامنة.", "tr": "ذَ كلاس ستارتس آت إيت" },
    { "id": "ti_s8", "en": "I sleep at ten at night.", "ar": "أنام في العاشرة ليلاً.", "tr": "آي سليب آت تِن آت نايت" },
    { "id": "ti_s9", "en": "Wait a minute, please.", "ar": "انتظر دقيقة من فضلك.", "tr": "ويت إيه مِنِت، پليز" },
    { "id": "ti_s10", "en": "I work five days a week.", "ar": "أعمل خمسة أيام في الأسبوع.", "tr": "آي وِرك فايڤ ديز إيه ويك" }
