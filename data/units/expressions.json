  "sentences": [
    { "id": "ex_s1", "en": "Sorry, I don't understand. Can you repeat?", "ar": "آسف، لا أفهم. هل يمكنك التكرار؟", "tr": "سوري، آي دونت أندَرستاند. كان يو رِپيت" },
    { "id": "ex_s2", "en": "Please speak slowly, I am learning.", "ar": "من فضلك تكلم ببطء، أنا أتعلم.", "tr": "پليز سپيك سلولي، آيم لِرنِنغ" },
    { "id": "ex_s3", "en": "How do you say this in English?", "ar": "كيف تقول هذا بالإنجليزية؟", "tr": "هاو دو يو سيه ذِس إن إنغلِش" },
    { "id": "ex_s4", "en": "Just a moment, please.", "ar": "لحظة من فضلك.", "tr": "جَست إيه مومِنت، پليز" },
    { "id": "ex_s5", "en": "Don't worry, everything is fine.", "ar": "لا تقلق، كل شيء بخير.", "tr": "دونت وَري، إڤريثِنغ إز فاين" },
    { "id": "ex_s6", "en": "Thanks a lot for your help.", "ar": "شكراً جزيلاً على مساعدتك.", "tr": "ثانكس إيه لوت فور يور هِلپ" },
    { "id": "ex_s7", "en": "Good luck with your exam!", "ar": "حظاً موفقاً في امتحانك!", "tr": "غُود لَك وِذ يور إغزام" },
    { "id": "ex_s8", "en": "Can I help you with something?", "ar": "هل أستطيع مساعدتك في شيء؟", "tr": "كان آي هِلپ يو وِذ سَمثِنغ" },
    { "id": "ex_s9", "en": "I am not sure, but I think yes.", "ar": "لست متأكداً، لكن أظن نعم.", "tr": "آيم نوت شور، بَت آي ثِنك يِس" },
    { "id": "ex_s10", "en": "Never mind, it is not important.", "ar": "لا يهم، ليس مهماً.", "tr": "نِڤَر مايند، إت إز نوت إمپورتَنت" },
    { "id": "ex_s11", "en": "Excuse me, where is the station?", "ar": "لو سمحت، أين المحطة؟", "tr": "إكسكيوز مي، وير إز ذَ ستيشِن" },
    { "id": "ex_s12", "en": "Hurry up, we are late!", "ar": "أسرع، نحن متأخرون!", "tr": "هَري أب، وي آر ليت" },
    { "id": "ex_s13", "en": "I forgot my keys at home.", "ar": "نسيت مفاتيحي في البيت.", "tr": "آي فَرغوت ماي كيز آت هوم" },
    { "id": "ex_s14", "en": "Get well soon, my friend.", "ar": "سلامتك يا صديقي.", "tr": "غِت وِل سون، ماي فرِند" },
    { "id": "ex_s15", "en": "Yes, please. That would be great.", "ar": "نعم من فضلك. سيكون ذلك رائعاً.", "tr": "يِس، پليز. ذات وود بي غريت" },
    { "id": "ex_s16", "en": "No, thank you. I am fine.", "ar": "لا، شكراً. أنا بخير.", "tr": "نو، ثانك يو. آيم فاين" }
  ]
