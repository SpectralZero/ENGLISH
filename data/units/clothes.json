  "sentences": [
    {
      "id": "cl_s1",
      "en": "I need new shoes.",
      "ar": "أحتاج حذاءً جديداً.",
      "tr": "آي نيد نيو شوز"
    },
    {
      "id": "cl_s2",
      "en": "This shirt is too big.",
      "ar": "هذا القميص كبير جداً.",
      "tr": "ذِس شيرت إز تو بِغ"
    },
    {
      "id": "cl_s3",
      "en": "How much is this jacket?",
      "ar": "بكم هذه السترة؟",
      "tr": "هاو مَتش إز ذِس جاكِت"
    },
    {
      "id": "cl_s4",
      "en": "Can I try it on, please?",
      "ar": "هل يمكنني تجربته من فضلك؟",
      "tr": "كان آي تراي إت أون، پليز"
    },
    {
      "id": "cl_s5",
      "en": "I wear a coat in winter.",
      "ar": "ألبس معطفاً في الشتاء.",
      "tr": "آي وير إيه كوت إن وِنتَر"
    },
    {
      "id": "cl_s6",
      "en": "Do you have a bigger size?",
      "ar": "هل لديك مقاس أكبر؟",
      "tr": "دو يو هاڤ إيه بِغَر سايز"
    },
    {
      "id": "cl_s7",
      "en": "Her dress is beautiful.",
      "ar": "فستانها جميل.",
      "tr": "هير درِس إز بيوتِفُل"
    },
    {
      "id": "cl_s8",
      "en": "These clothes are cheap.",
      "ar": "هذه الملابس رخيصة.",
      "tr": "ذيز كلوذز آر تشيپ"
    },
    {
      "id": "cl_s9",
      "en": "This colour suits you.",
      "ar": "هذا اللون يناسبك.",
      "tr": "ذِس كَلَر سوتس يو"
    },
    {
      "id": "cl_s10",
      "en": "Where is the fitting room?",
      "ar": "أين غرفة القياس؟",
      "tr": "وير إز ذَ فِتِنغ روم"
    },
    {
      "id": "cl_s11",
      "en": "These shoes are very comfortable.",
      "ar": "هذا الحذاء مريح جداً.",
      "tr": "ذيز شوز آر ڤيري كَمفَرتَبِل"
    },
    {
      "id": "cl_s12",
      "en": "I wash my clothes on Friday.",
      "ar": "أغسل ملابسي يوم الجمعة.",
      "tr": "آي واش ماي كلوذز أون فرايديه"
    },
    {
      "id": "cl_s13",
      "en": "It is too small for me.",
      "ar": "إنه صغير عليّ.",
      "tr": "إت إز تو سمول فور مي"
    },
    {
      "id": "cl_s14",
      "en": "Do you sell socks here?",
      "ar": "هل تبيعون جوارب هنا؟",
      "tr": "دو يو سِل سوكس هير"
    },
    {
      "id": "cl_s15",
      "en": "I forgot my jacket at work.",
      "ar": "نسيت سترتي في العمل.",
      "tr": "آي فَرغوت ماي جاكِت آت وِرك"
    },
    {
      "id": "cl_s16",
      "en": "Wear something warm today.",
      "ar": "البس شيئاً دافئاً اليوم.",
      "tr": "وير سَمثِنغ وورم تُوديه"
    }
  ]
