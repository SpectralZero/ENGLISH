  "sentences": [
    {
      "id": "fe_s1",
      "en": "I am very happy today.",
      "ar": "أنا سعيد جداً اليوم.",
      "tr": "آيم ڤيري هابي تُوديه"
    },
    {
      "id": "fe_s2",
      "en": "Why are you sad?",
      "ar": "لماذا أنت حزين؟",
      "tr": "واي آر يو ساد"
    },
    {
      "id": "fe_s3",
      "en": "I feel tired after work.",
      "ar": "أشعر بالتعب بعد العمل.",
      "tr": "آي فيل تايَرد آفتَر وِرك"
    },
    {
      "id": "fe_s4",
      "en": "Don't worry about it.",
      "ar": "لا تقلق بشأن ذلك.",
      "tr": "دونت وَري أباوت إت"
    },
    {
      "id": "fe_s5",
      "en": "I miss my family a lot.",
      "ar": "أشتاق لعائلتي كثيراً.",
      "tr": "آي مِس ماي فامِلي إيه لوت"
    },
    {
      "id": "fe_s6",
      "en": "He is angry with me.",
      "ar": "هو غاضب مني.",
      "tr": "هي إز آنغري وِذ مي"
    },
    {
      "id": "fe_s7",
      "en": "I hope to see you soon.",
      "ar": "آمل أن أراك قريباً.",
      "tr": "آي هوپ تو سي يو سون"
    },
    {
      "id": "fe_s8",
      "en": "Congratulations! I am proud of you.",
      "ar": "مبروك! أنا فخور بك.",
      "tr": "كَنغراتشُوليشِنز! آيم پراود أوڤ يو"
    },
    {
      "id": "fe_s9",
      "en": "I am a little nervous.",
      "ar": "أنا متوتر قليلاً.",
      "tr": "آيم إيه لِتِل نيرڤَس"
    },
    {
      "id": "fe_s10",
      "en": "Smile, life is beautiful.",
      "ar": "ابتسم، الحياة جميلة.",
      "tr": "سمايل، لايف إز بيوتِفُل"
    },
    {
      "id": "fe_s11",
      "en": "I am worried about the exam.",
      "ar": "أنا قلق بشأن الامتحان.",
      "tr": "آيم وَريد أباوت ذي إغزام"
    },
    {
      "id": "fe_s12",
      "en": "That makes me happy.",
      "ar": "هذا يسعدني.",
      "tr": "ذات ميكس مي هابي"
    },
    {
      "id": "fe_s13",
      "en": "I felt very lonely there.",
      "ar": "شعرت بوحدة شديدة هناك.",
      "tr": "آي فِلت ڤيري لونلي ذير"
    },
    {
      "id": "fe_s14",
      "en": "Please don't be upset.",
      "ar": "من فضلك لا تنزعج.",
      "tr": "پليز دونت بي أپسِت"
    },
    {
      "id": "fe_s15",
      "en": "I am excited about tomorrow.",
      "ar": "أنا متحمس بشأن الغد.",
      "tr": "آيم إكسايتِد أباوت تُومورو"
    },
    {
      "id": "fe_s16",
      "en": "He was surprised to see me.",
      "ar": "تفاجأ برؤيتي.",
      "tr": "هي واز سَرپرايزد تو سي مي"
    },
    {
      "id": "fe_s17",
      "en": "I am proud of my family.",
      "ar": "أنا فخور بعائلتي.",
      "tr": "آيم پراود أوڤ ماي فامِلي"
    },
    {
      "id": "fe_s18",
      "en": "Everything will be fine.",
      "ar": "كل شيء سيكون بخير.",
      "tr": "إڤريثِنغ وِل بي فاين"
    }
  ]
