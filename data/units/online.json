    {
      "id": "ol_s1",
      "en": "My order has not arrived yet.",
      "ar": "طلبي لم يصل بعد.",
      "tr": "ماي أوردَر هاز نوت أرايڤد يِت"
    },
    {
      "id": "ol_s2",
      "en": "Do you deliver to this address?",
      "ar": "هل توصلون إلى هذا العنوان؟",
      "tr": "دو يو دِليڤَر تو ذِس أدرِس"
    },
    {
      "id": "ol_s3",
      "en": "I received the wrong item.",
      "ar": "استلمت منتجاً خاطئاً.",
      "tr": "آي رِسيڤد ذَ رونغ آيتِم"
    },
    {
      "id": "ol_s4",
      "en": "Can I return it?",
      "ar": "هل يمكنني إرجاعه؟",
      "tr": "كان آي رِتيرن إت"
    },
    {
      "id": "ol_s5",
      "en": "I want a refund, please.",
      "ar": "أريد استرجاع المبلغ من فضلك.",
      "tr": "آي وانت إيه رِفَند، پليز"
    },
    {
      "id": "ol_s6",
      "en": "Is cash on delivery possible?",
      "ar": "هل الدفع عند الاستلام ممكن؟",
      "tr": "إز كاش أون دِليڤَري پوسِبِل"
    },
    {
      "id": "ol_s7",
      "en": "The item arrived damaged.",
      "ar": "وصل المنتج تالفاً.",
      "tr": "ذي آيتِم أرايڤد دامِجد"
    },
    {
      "id": "ol_s8",
      "en": "Read the reviews before you buy.",
      "ar": "اقرأ التقييمات قبل الشراء.",
      "tr": "ريد ذَ رِڤيوز بِفور يو باي"
    },
    {
      "id": "ol_s9",
      "en": "This offer ends tomorrow.",
      "ar": "هذا العرض ينتهي غداً.",
      "tr": "ذِس أوفَر إندز تُومورو"
    },
    {
      "id": "ol_s10",
      "en": "I want to cancel my order.",
      "ar": "أريد إلغاء طلبي.",
      "tr": "آي وانت تو كانسِل ماي أوردَر"
    }
