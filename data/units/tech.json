  "sentences": [
    {
      "id": "tc_s1",
      "en": "My laptop is very slow today.",
      "ar": "حاسوبي بطيء جداً اليوم.",
      "tr": "ماي لاپتوپ إز ڤيري سلو تُوديه"
    },
    {
      "id": "tc_s2",
      "en": "Don't forget to save the file.",
      "ar": "لا تنسَ حفظ الملف.",
      "tr": "دونت فَرغِت تو سيڤ ذَ فايل"
    },
    {
      "id": "tc_s3",
      "en": "I forgot my password.",
      "ar": "نسيت كلمة السر.",
      "tr": "آي فَرغوت ماي پاسوِرد"
    },
    {
      "id": "tc_s4",
      "en": "Can you send me the link?",
      "ar": "هل يمكنك إرسال الرابط لي؟",
      "tr": "كان يو سِند مي ذَ لِنك"
    },
    {
      "id": "tc_s5",
      "en": "Try to restart the computer.",
      "ar": "حاول إعادة تشغيل الحاسوب.",
      "tr": "تراي تو رِيستارت ذَ كَمپيوتَر"
    },
    {
      "id": "tc_s6",
      "en": "The printer is not working.",
      "ar": "الطابعة لا تعمل.",
      "tr": "ذَ پرِنتَر إز نوت وِركِنغ"
    },
    {
      "id": "tc_s7",
      "en": "I need to update the app.",
      "ar": "أحتاج تحديث التطبيق.",
      "tr": "آي نيد تو أپديت ذي آپ"
    },
    {
      "id": "tc_s8",
      "en": "Keep a backup of your files.",
      "ar": "احتفظ بنسخة احتياطية من ملفاتك.",
      "tr": "كيپ إيه باكأپ أوڤ يور فايلز"
    },
    {
      "id": "tc_s9",
      "en": "Please log out when you finish.",
      "ar": "من فضلك سجّل الخروج عند الانتهاء.",
      "tr": "پليز لوغ أوت وِن يو فِنِش"
    },
    {
      "id": "tc_s10",
      "en": "Is this website safe?",
      "ar": "هل هذا الموقع آمن؟",
      "tr": "إز ذِس وِبسايت سيف"
    }
  ]
}
