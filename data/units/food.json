  "sentences": [
    {
      "id": "fo_s1",
      "en": "I am hungry.",
      "ar": "أنا جائع.",
      "tr": "آي آم هَنغري"
    },
    {
      "id": "fo_s2",
      "en": "I want water, please.",
      "ar": "أريد ماء من فضلك.",
      "tr": "آي وانت ووتَر، پليز"
    },
    {
      "id": "fo_s3",
      "en": "What do you eat for breakfast?",
      "ar": "ماذا تأكل في الفطور؟",
      "tr": "وات دو يو إيت فور برِكفَست"
    },
    {
      "id": "fo_s4",
      "en": "This food is delicious.",
      "ar": "هذا الطعام لذيذ.",
      "tr": "ذِس فوود إز دِليشَس"
    },
    {
      "id": "fo_s5",
      "en": "I don't drink coffee.",
      "ar": "أنا لا أشرب القهوة.",
      "tr": "آي دونت درِنك كوفي"
    },
    {
      "id": "fo_s6",
      "en": "Can I have the menu?",
      "ar": "هل يمكنني الحصول على قائمة الطعام؟",
      "tr": "كان آي هاڤ ذَ مِنيو"
    },
    {
      "id": "fo_s7",
      "en": "My mother cooks very well.",
      "ar": "أمي تطبخ بشكل ممتاز.",
      "tr": "ماي مَذَر كوكس ڤيري وِل"
    },
    {
      "id": "fo_s8",
      "en": "The tea is very hot.",
      "ar": "الشاي ساخن جداً.",
      "tr": "ذَ تي إز ڤيري هوت"
    },
    {
      "id": "fo_s9",
      "en": "We have dinner at eight.",
      "ar": "نتناول العشاء في الثامنة.",
      "tr": "وي هاڤ دِنَر آت إيت"
    },
    {
      "id": "fo_s10",
      "en": "The bill, please.",
      "ar": "الحساب من فضلك.",
      "tr": "ذَ بِل، پليز"
    },
    {
      "id": "fo_s11",
      "en": "I like rice with chicken.",
      "ar": "أحب الأرز مع الدجاج.",
      "tr": "آي لايك رايس وِذ تشِكِن"
    },
    {
      "id": "fo_s12",
      "en": "No sugar in my tea, please.",
      "ar": "بدون سكر في الشاي من فضلك.",
      "tr": "نو شُوغَر إن ماي تي، پليز"
    },
    {
      "id": "fo_s13",
      "en": "What is for dinner tonight?",
      "ar": "ماذا سنتعشى الليلة؟",
      "tr": "وات إز فور دِنَر تُونايت"
    },
    {
      "id": "fo_s14",
      "en": "I don't eat meat.",
      "ar": "أنا لا آكل اللحم.",
      "tr": "آي دونت إيت ميت"
    },
    {
      "id": "fo_s15",
      "en": "Add a little more salt.",
      "ar": "أضف قليلاً من الملح.",
      "tr": "آد إيه لِتِل مور سولت"
    },
    {
      "id": "fo_s16",
      "en": "This bread is fresh.",
      "ar": "هذا الخبز طازج.",
      "tr": "ذِس برِد إز فرِش"
    },
    {
      "id": "fo_s17",
      "en": "Would you like some tea?",
      "ar": "هل تريد بعض الشاي؟",
      "tr": "وود يو لايك سَم تي"
    },
    {
      "id": "fo_s18",
      "en": "I am still hungry.",
      "ar": "ما زلت جائعاً.",
      "tr": "آيم ستِل هَنغري"
    },
    {
      "id": "fo_s19",
      "en": "The soup is too hot.",
      "ar": "الشوربة ساخنة جداً.",
      "tr": "ذَ سوپ إز تو هوت"
    },
    {
      "id": "fo_s20",
      "en": "Let's eat something light.",
      "ar": "لنأكل شيئاً خفيفاً.",
      "tr": "لِتس إيت سَمثِنغ لايت"
    },
    {
      "id": "fo_s21",
      "en": "I drink milk every morning.",
      "ar": "أشرب الحليب كل صباح.",
      "tr": "آي درِنك مِلك إڤري مورنِنغ"
    },
    {
      "id": "fo_s22",
      "en": "Put it on the plate, please.",
      "ar": "ضعه في الطبق من فضلك.",
      "tr": "پوت إت أون ذَ پليت، پليز"
    }
  ]
