  "sentences": [
    {
      "id": "gr_s1",
      "en": "Hello, my name is Omar.",
      "ar": "مرحباً، اسمي عمر.",
      "tr": "هَلو، ماي نيم إز عمر"
    },
    {
      "id": "gr_s2",
      "en": "Good morning! How are you?",
      "ar": "صباح الخير! كيف حالك؟",
      "tr": "غُود مورنِنغ! هاو آر يو"
    },
    {
      "id": "gr_s3",
      "en": "I am fine, thank you.",
      "ar": "أنا بخير، شكراً لك.",
      "tr": "آي آم فاين، ثانك يو"
    },
    {
      "id": "gr_s4",
      "en": "Nice to meet you.",
      "ar": "سعيد بلقائك.",
      "tr": "نايس تو ميت يو"
    },
    {
      "id": "gr_s5",
      "en": "Where are you from?",
      "ar": "من أين أنت؟",
      "tr": "وير آر يو فروم"
    },
    {
      "id": "gr_s6",
      "en": "I am from Egypt.",
      "ar": "أنا من مصر.",
      "tr": "آي آم فروم إيجِبت"
    },
    {
      "id": "gr_s7",
      "en": "Please, sit here.",
      "ar": "من فضلك، اجلس هنا.",
      "tr": "پليز، سِت هير"
    },
    {
      "id": "gr_s8",
      "en": "Excuse me, can you help me?",
      "ar": "لو سمحت، هل يمكنك مساعدتي؟",
      "tr": "إكسكيوز مي، كان يو هِلب مي"
    },
    {
      "id": "gr_s9",
      "en": "See you tomorrow.",
      "ar": "أراك غداً.",
      "tr": "سي يو تُومورو"
    },
    {
      "id": "gr_s10",
      "en": "Good night, sleep well.",
      "ar": "تصبح على خير، نم جيداً.",
      "tr": "غُود نايت، سليب وِل"
    },
    {
      "id": "gr_s11",
      "en": "This is my friend Ali.",
      "ar": "هذا صديقي علي.",
      "tr": "ذِس إز ماي فرِند علي"
    },
    {
      "id": "gr_s12",
      "en": "Thank you very much.",
      "ar": "شكراً جزيلاً.",
      "tr": "ثانك يو ڤيري مَتش"
    },
    {
      "id": "gr_s13",
      "en": "Good to see you again.",
      "ar": "سعيد برؤيتك مرة أخرى.",
      "tr": "غُود تو سي يو أغين"
    },
    {
      "id": "gr_s14",
      "en": "How is everything?",
      "ar": "كيف الأحوال؟",
      "tr": "هاو إز إڤريثِنغ"
    },
    {
      "id": "gr_s15",
      "en": "Everything is good, thanks.",
      "ar": "كل شيء بخير، شكراً.",
      "tr": "إڤريثِنغ إز غُود، ثانكس"
    },
    {
      "id": "gr_s16",
      "en": "What is your family name?",
      "ar": "ما اسم عائلتك؟",
      "tr": "وات إز يور فامِلي نيم"
    },
    {
      "id": "gr_s17",
      "en": "I am happy to meet you.",
      "ar": "أنا سعيد بلقائك.",
      "tr": "آيم هابي تو ميت يو"
    },
    {
      "id": "gr_s18",
      "en": "Please come in.",
      "ar": "تفضّل بالدخول.",
      "tr": "پليز كَم إن"
    },
    {
      "id": "gr_s19",
      "en": "Have a good trip.",
      "ar": "رحلة سعيدة.",
      "tr": "هاڤ إيه غُود ترِپ"
    },
    {
      "id": "gr_s20",
      "en": "Sorry, I am in a hurry.",
      "ar": "آسف، أنا مستعجل.",
      "tr": "سوري، آيم إن إيه هَري"
    },
    {
      "id": "gr_s21",
      "en": "Welcome back!",
      "ar": "أهلاً بعودتك!",
      "tr": "وِلكَم باك"
    },
    {
      "id": "gr_s22",
      "en": "Peace be upon you.",
      "ar": "السلام عليكم.",
      "tr": "پيس بي أپون يو"
    },
    {
      "id": "gr_s23",
      "en": "Good morning, everyone.",
      "ar": "صباح الخير للجميع.",
      "tr": "غُود مورنِنغ، إڤريوان"
    },
    {
      "id": "gr_s24",
      "en": "Thank you for your help.",
      "ar": "شكراً على مساعدتك.",
      "tr": "ثانك يو فور يور هِلپ"
    }
  ]
