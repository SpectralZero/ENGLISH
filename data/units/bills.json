  "sentences": [
    {
      "id": "bl_s1",
      "en": "I pay the rent every month.",
      "ar": "أدفع الإيجار كل شهر.",
      "tr": "آي پيه ذَ رِنت إڤري مَنث"
    },
    {
      "id": "bl_s2",
      "en": "The electricity bill is high this month.",
      "ar": "فاتورة الكهرباء مرتفعة هذا الشهر.",
      "tr": "ذي إلِكترِسِتي بِل إز هاي ذِس مَنث"
    },
    {
      "id": "bl_s3",
      "en": "When is the due date?",
      "ar": "متى تاريخ الاستحقاق؟",
      "tr": "وِن إز ذَ ديو ديت"
    },
    {
      "id": "bl_s4",
      "en": "I can't afford it right now.",
      "ar": "لا أقدر على شرائه الآن.",
      "tr": "آي كانت أفورد إت رايت ناو"
    },
    {
      "id": "bl_s5",
      "en": "I try to save some money.",
      "ar": "أحاول ادخار بعض المال.",
      "tr": "آي تراي تو سيڤ سَم مَني"
    },
    {
      "id": "bl_s6",
      "en": "Prices went up this year.",
      "ar": "ارتفعت الأسعار هذا العام.",
      "tr": "پرايسِز وِنت أب ذِس يِير"
    },
    {
      "id": "bl_s7",
      "en": "Do I have to pay a late fee?",
      "ar": "هل عليّ دفع غرامة تأخير؟",
      "tr": "دو آي هاڤ تو پيه إيه ليت في"
    },
    {
      "id": "bl_s8",
      "en": "Keep the receipt, please.",
      "ar": "احتفظ بالإيصال من فضلك.",
      "tr": "كيپ ذَ رِسيت، پليز"
    },
    {
      "id": "bl_s9",
      "en": "My salary comes at the end of the month.",
      "ar": "راتبي يأتي نهاية الشهر.",
      "tr": "ماي سالَري كَمز آت ذي إند أوڤ ذَ مَنث"
    },
    {
      "id": "bl_s10",
      "en": "We need a monthly budget.",
      "ar": "نحتاج ميزانية شهرية.",
      "tr": "وي نيد إيه مَنثلي بَدجِت"
    }
  ]
