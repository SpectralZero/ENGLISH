  "sentences": [
    {
      "id": "cd_s1",
      "en": "The baby is sleeping now.",
      "ar": "الرضيع نائم الآن.",
      "tr": "ذَ بيبي إز سليپِنغ ناو"
    },
    {
      "id": "cd_s2",
      "en": "My son goes to nursery.",
      "ar": "ابني يذهب إلى الحضانة.",
      "tr": "ماي سَن غوز تو نيرسَري"
    },
    {
      "id": "cd_s3",
      "en": "Please be quiet, the baby is asleep.",
      "ar": "من فضلك اهدأ، الرضيع نائم.",
      "tr": "پليز بي كوايَت، ذَ بيبي إز أسليپ"
    },
    {
      "id": "cd_s4",
      "en": "She is learning to walk.",
      "ar": "هي تتعلم المشي.",
      "tr": "شي إز لِرنِنغ تو ووك"
    },
    {
      "id": "cd_s5",
      "en": "Don't touch that, it is dangerous.",
      "ar": "لا تلمس ذلك، إنه خطير.",
      "tr": "دونت تَتش ذات، إت إز دينجَرَس"
    },
    {
      "id": "cd_s6",
      "en": "I read him a story at bedtime.",
      "ar": "أقرأ له قصة وقت النوم.",
      "tr": "آي ريد هِم إيه ستوري آت بِدتايم"
    },
    {
      "id": "cd_s7",
      "en": "The children are playing outside.",
      "ar": "الأطفال يلعبون في الخارج.",
      "tr": "ذَ تشِلدرِن آر پليينغ أوتسايد"
    },
    {
      "id": "cd_s8",
      "en": "Have you done your homework?",
      "ar": "هل أنهيت واجبك؟",
      "tr": "هاڤ يو دَن يور هومويرك"
    },
    {
      "id": "cd_s9",
      "en": "He needs his vaccination this week.",
      "ar": "يحتاج تطعيمه هذا الأسبوع.",
      "tr": "هي نيدز هِز ڤاكسِنيشِن ذِس ويك"
    },
    {
      "id": "cd_s10",
      "en": "Take care of your little sister.",
      "ar": "اعتنِ بأختك الصغيرة.",
      "tr": "تيك كير أوڤ يور لِتِل سِستَر"
    }
  ]
