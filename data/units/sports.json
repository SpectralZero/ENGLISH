  "sentences": [
    {
      "id": "sp_s1",
      "en": "I play football every week.",
      "ar": "ألعب كرة القدم كل أسبوع.",
      "tr": "آي پليه فوتبول إڤري ويك"
    },
    {
      "id": "sp_s2",
      "en": "What do you do in your free time?",
      "ar": "ماذا تفعل في وقت فراغك؟",
      "tr": "وات دو يو دو إن يور فري تايم"
    },
    {
      "id": "sp_s3",
      "en": "My favorite hobby is reading.",
      "ar": "هوايتي المفضلة هي القراءة.",
      "tr": "ماي فيڤَرِت هوبي إز ريدِنغ"
    },
    {
      "id": "sp_s4",
      "en": "I go to the gym three times a week.",
      "ar": "أذهب إلى النادي ثلاث مرات أسبوعياً.",
      "tr": "آي غو تو ذَ جِم ثري تايمز إيه ويك"
    },
    {
      "id": "sp_s5",
      "en": "Our team won the match.",
      "ar": "فريقنا فاز بالمباراة.",
      "tr": "أوَر تيم وُن ذَ ماتش"
    },
    {
      "id": "sp_s6",
      "en": "Do you want to play with us?",
      "ar": "هل تريد اللعب معنا؟",
      "tr": "دو يو وانت تو پليه وِذ أَس"
    },
    {
      "id": "sp_s7",
      "en": "I like swimming in summer.",
      "ar": "أحب السباحة في الصيف.",
      "tr": "آي لايك سوِمِنغ إن سَمَر"
    },
    {
      "id": "sp_s8",
      "en": "I walk for an hour every day.",
      "ar": "أمشي ساعة كل يوم.",
      "tr": "آي ووك فور آن آوَر إڤري ديه"
    },
    {
      "id": "sp_s9",
      "en": "He is a very good player.",
      "ar": "هو لاعب جيد جداً.",
      "tr": "هي إز إيه ڤيري غُود پليَر"
    },
    {
      "id": "sp_s10",
      "en": "Sport keeps me healthy.",
      "ar": "الرياضة تبقيني بصحة جيدة.",
      "tr": "سپورت كيپس مي هِلثي"
    },
    {
      "id": "sp_s11",
      "en": "The game starts in ten minutes.",
      "ar": "المباراة تبدأ بعد عشر دقائق.",
      "tr": "ذَ غيم ستارتس إن تِن مِنِتس"
    },
    {
      "id": "sp_s12",
      "en": "I go running every morning.",
      "ar": "أذهب للجري كل صباح.",
      "tr": "آي غو رَنِنغ إڤري مورنِنغ"
    },
    {
      "id": "sp_s13",
      "en": "Which team do you support?",
      "ar": "أي فريق تشجّع؟",
      "tr": "وِتش تيم دو يو سَپورت"
    },
    {
      "id": "sp_s14",
      "en": "We lost, but it was fun.",
      "ar": "خسرنا، لكنه كان ممتعاً.",
      "tr": "وي لوست، بَت إت واز فَن"
    },
    {
      "id": "sp_s15",
      "en": "I am tired after training.",
      "ar": "أنا متعب بعد التدريب.",
      "tr": "آيم تايَرد آفتَر ترينِنغ"
    },
    {
      "id": "sp_s16",
      "en": "Sport is good for the body.",
      "ar": "الرياضة مفيدة للجسم.",
      "tr": "سپورت إز غُود فور ذَ بودي"
    },
    {
      "id": "sp_s17",
      "en": "I like listening to music while walking.",
      "ar": "أحب سماع الموسيقى أثناء المشي.",
      "tr": "آي لايك لِسِنِنغ تو ميوزِك وايل ووكِنغ"
    }
  ]
