  "sentences": [
    {
      "id": "cr_s1",
      "en": "He is an honest and reliable man.",
      "ar": "هو رجل أمين ويُعتمد عليه.",
      "tr": "هي إز آن أونِست آند رِلايَبِل مان"
    },
    {
      "id": "cr_s2",
      "en": "Please calm down and listen.",
      "ar": "من فضلك اهدأ واستمع.",
      "tr": "پليز كالم داون آند لِسِن"
    },
    {
      "id": "cr_s3",
      "en": "I trust him completely.",
      "ar": "أثق به تماماً.",
      "tr": "آي ترَست هِم كَمپليتلي"
    },
    {
      "id": "cr_s4",
      "en": "She always keeps her promise.",
      "ar": "هي دائماً تفي بوعدها.",
      "tr": "شي أولويز كيپس هير پرومِس"
    },
    {
      "id": "cr_s5",
      "en": "Respect your parents.",
      "ar": "احترم والديك.",
      "tr": "رِسپِكت يور پيرِنتس"
    },
    {
      "id": "cr_s6",
      "en": "I am sorry, it was my mistake.",
      "ar": "أنا آسف، كان خطئي.",
      "tr": "آيم سوري، إت واز ماي مِستيك"
    },
    {
      "id": "cr_s7",
      "en": "Don't blame him, he was busy.",
      "ar": "لا تلمه، كان مشغولاً.",
      "tr": "دونت بليم هِم، هي واز بِزي"
    },
    {
      "id": "cr_s8",
      "en": "Being on time shows respect.",
      "ar": "الالتزام بالوقت احترام.",
      "tr": "بيينغ أون تايم شوز رِسپِكت"
    },
    {
      "id": "cr_s9",
      "en": "He is very generous with everyone.",
      "ar": "هو كريم جداً مع الجميع.",
      "tr": "هي إز ڤيري جِنَرَس وِذ إڤريوان"
    },
    {
      "id": "cr_s10",
      "en": "Please keep this a secret.",
      "ar": "من فضلك احفظ هذا سراً.",
      "tr": "پليز كيپ ذِس إيه سيكرِت"
    }
  ]
