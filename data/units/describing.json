  "sentences": [
    {
      "id": "dp_s1",
      "en": "What does he look like?",
      "ar": "كيف يبدو شكله؟",
      "tr": "وات دَز هي لوك لايك"
    },
    {
      "id": "dp_s2",
      "en": "He is tall with dark hair.",
      "ar": "هو طويل وشعره داكن.",
      "tr": "هي إز تول وِذ دارك هير"
    },
    {
      "id": "dp_s3",
      "en": "She wears glasses.",
      "ar": "هي ترتدي نظارة.",
      "tr": "شي ويرز غلاسِز"
    },
    {
      "id": "dp_s4",
      "en": "My brother has a beard.",
      "ar": "أخي لديه لحية.",
      "tr": "ماي براذَر هاز إيه بيرد"
    },
    {
      "id": "dp_s5",
      "en": "He is very polite and friendly.",
      "ar": "هو مؤدب وودود جداً.",
      "tr": "هي إز ڤيري پُولايت آند فرِندلي"
    },
    {
      "id": "dp_s6",
      "en": "She is about my age.",
      "ar": "هي في مثل عمري تقريباً.",
      "tr": "شي إز أباوت ماي إيج"
    },
    {
      "id": "dp_s7",
      "en": "You look like your father.",
      "ar": "أنت تشبه أباك.",
      "tr": "يو لوك لايك يور فاذَر"
    },
    {
      "id": "dp_s8",
      "en": "He is a hard-working man.",
      "ar": "هو رجل مجتهد.",
      "tr": "هي إز إيه هارد وِركِنغ مان"
    },
    {
      "id": "dp_s9",
      "en": "She has a beautiful smile.",
      "ar": "لديها ابتسامة جميلة.",
      "tr": "شي هاز إيه بيوتِفُل سمايل"
    },
    {
      "id": "dp_s10",
      "en": "Don't be shy, come and talk.",
      "ar": "لا تخجل، تعال وتحدث.",
      "tr": "دونت بي شاي، كَم آند توك"
    }
  ]
}
