  "sentences": [
    {
      "id": "ho_s1",
      "en": "I live in a small apartment.",
      "ar": "أسكن في شقة صغيرة.",
      "tr": "آي لِڤ إن إيه سمول أپارتمِنت"
    },
    {
      "id": "ho_s2",
      "en": "My house has three rooms.",
      "ar": "بيتي فيه ثلاث غرف.",
      "tr": "ماي هاوس هاز ثري رومز"
    },
    {
      "id": "ho_s3",
      "en": "Please open the window.",
      "ar": "من فضلك افتح النافذة.",
      "tr": "پليز أوپِن ذَ وِندو"
    },
    {
      "id": "ho_s4",
      "en": "The kitchen is very clean.",
      "ar": "المطبخ نظيف جداً.",
      "tr": "ذَ كِتشِن إز ڤيري كلين"
    },
    {
      "id": "ho_s5",
      "en": "Where is the bathroom?",
      "ar": "أين الحمام؟",
      "tr": "وير إز ذَ باثروم"
    },
    {
      "id": "ho_s6",
      "en": "The keys are on the table.",
      "ar": "المفاتيح على الطاولة.",
      "tr": "ذَ كيز آر أون ذَ تيبِل"
    },
    {
      "id": "ho_s7",
      "en": "I watch television in the evening.",
      "ar": "أشاهد التلفاز في المساء.",
      "tr": "آي واتش تِلِڤيجِن إن ذي إيفنِنغ"
    },
    {
      "id": "ho_s8",
      "en": "Close the door, please.",
      "ar": "أغلق الباب من فضلك.",
      "tr": "كلوز ذَ دور، پليز"
    },
    {
      "id": "ho_s9",
      "en": "There is a garden near my house.",
      "ar": "توجد حديقة قرب بيتي.",
      "tr": "ذير إز إيه غاردِن نير ماي هاوس"
    },
    {
      "id": "ho_s10",
      "en": "My bedroom is upstairs.",
      "ar": "غرفة نومي في الأعلى.",
      "tr": "ماي بِدروم إز أپستيرز"
    },
    {
      "id": "ho_s11",
      "en": "Make yourself at home.",
      "ar": "اعتبر نفسك في بيتك.",
      "tr": "ميك يورسِلف آت هوم"
    },
    {
      "id": "ho_s12",
      "en": "The light in the kitchen is broken.",
      "ar": "الضوء في المطبخ معطّل.",
      "tr": "ذَ لايت إن ذَ كِتشِن إز بروكِن"
    },
    {
      "id": "ho_s13",
      "en": "I clean my room every Friday.",
      "ar": "أنظّف غرفتي كل جمعة.",
      "tr": "آي كلين ماي روم إڤري فرايديه"
    },
    {
      "id": "ho_s14",
      "en": "Put your bag on the chair.",
      "ar": "ضع حقيبتك على الكرسي.",
      "tr": "پوت يور باغ أون ذَ تشير"
    },
    {
      "id": "ho_s15",
      "en": "We moved to a new apartment.",
      "ar": "انتقلنا إلى شقة جديدة.",
      "tr": "وي موڤد تو إيه نيو أپارتمِنت"
    },
    {
      "id": "ho_s16",
      "en": "The rent is too expensive.",
      "ar": "الإيجار غالٍ جداً.",
      "tr": "ذَ رِنت إز تو إكسپِنسِڤ"
    },
    {
      "id": "ho_s17",
      "en": "Is there hot water?",
      "ar": "هل يوجد ماء ساخن؟",
      "tr": "إز ذير هوت ووتَر"
    },
    {
      "id": "ho_s18",
      "en": "My room is on the second floor.",
      "ar": "غرفتي في الطابق الثاني.",
      "tr": "ماي روم إز أون ذَ سِكِند فلور"
    },
    {
      "id": "ho_s19",
      "en": "Please turn off the light.",
      "ar": "من فضلك أطفئ الضوء.",
      "tr": "پليز تيرن أوف ذَ لايت"
    },
    {
      "id": "ho_s20",
      "en": "What is your address?",
      "ar": "ما عنوانك؟",
      "tr": "وات إز يور أدرِس"
    }
  ]
