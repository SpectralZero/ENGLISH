  "sentences": [
    { "id": "fu_s1", "en": "I will call you tomorrow.", "ar": "سأتصل بك غداً.", "tr": "آي وِل كول يو تُومورو" },
    { "id": "fu_s2", "en": "I am going to visit my family next week.", "ar": "سأزور عائلتي الأسبوع القادم.", "tr": "آيم غويِنغ تو ڤِزِت ماي فامِلي نِكست ويك" },
    { "id": "fu_s3", "en": "Are you free tomorrow evening?", "ar": "هل أنت متفرغ مساء الغد؟", "tr": "آر يو فري تُومورو إيفنِنغ" },
    { "id": "fu_s4", "en": "Maybe I will come later.", "ar": "ربما سآتي لاحقاً.", "tr": "ميبي آي وِل كَم ليتَر" },
    { "id": "fu_s5", "en": "I hope to see you soon.", "ar": "آمل أن أراك قريباً.", "tr": "آي هوپ تو سي يو سون" },
    { "id": "fu_s6", "en": "My dream is to speak English well.", "ar": "حلمي أن أتحدث الإنجليزية جيداً.", "tr": "ماي دريم إز تو سپيك إنغلِش وِل" },
    { "id": "fu_s7", "en": "I will study English every day.", "ar": "سأدرس الإنجليزية كل يوم.", "tr": "آي وِل ستَدي إنغلِش إڤري ديه" },
    { "id": "fu_s8", "en": "I won't be late, I promise.", "ar": "لن أتأخر، أعدك.", "tr": "آي وونت بي ليت، آي پرومِس" },
    { "id": "fu_s9", "en": "Let's meet in front of the café.", "ar": "لنلتقِ أمام المقهى.", "tr": "لِتس ميت إن فرَنت أوڤ ذَ كافيه" },
    { "id": "fu_s10", "en": "Don't forget our appointment.", "ar": "لا تنسَ موعدنا.", "tr": "دونت فَرغِت أوَر أپوينتمِنت" },
    { "id": "fu_s11", "en": "I will think about it and tell you.", "ar": "سأفكر في الأمر وأخبرك.", "tr": "آي وِل ثِنك أباوت إت آند تِل يو" },
    { "id": "fu_s12", "en": "Next year I want to find a better job.", "ar": "العام القادم أريد إيجاد عمل أفضل.", "tr": "نِكست يِير آي وانت تو فايند إيه بِتَر جوب" }
  ]
