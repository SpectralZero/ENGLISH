  "sentences": [
    {
      "id": "v2_s1",
      "en": "Don't give up, try again.",
      "ar": "لا تستسلم، حاول مرة أخرى.",
      "tr": "دونت غِڤ أب، تراي أغين"
    },
    {
      "id": "v2_s2",
      "en": "I prefer tea to coffee.",
      "ar": "أفضّل الشاي على القهوة.",
      "tr": "آي پرِفير تي تو كوفي"
    },
    {
      "id": "v2_s3",
      "en": "Can you keep this for me?",
      "ar": "هل يمكنك الاحتفاظ بهذا لي؟",
      "tr": "كان يو كيپ ذِس فور مي"
    },
    {
      "id": "v2_s4",
      "en": "He decided to change his job.",
      "ar": "قرر تغيير عمله.",
      "tr": "هي دِسايدِد تو تشينج هِز جوب"
    },
    {
      "id": "v2_s5",
      "en": "I forgot to call you, sorry.",
      "ar": "نسيت أن أتصل بك، آسف.",
      "tr": "آي فَرغوت تو كول يو، سوري"
    },
    {
      "id": "v2_s6",
      "en": "We must continue until the end.",
      "ar": "يجب أن نستمر حتى النهاية.",
      "tr": "وي مَست كَنتِنيو أنتِل ذي إند"
    },
    {
      "id": "v2_s7",
      "en": "She lent me her book.",
      "ar": "أعارتني كتابها.",
      "tr": "شي لِنت مي هير بوك"
    },
    {
      "id": "v2_s8",
      "en": "My English is improving slowly.",
      "ar": "إنجليزيتي تتحسن ببطء.",
      "tr": "ماي إنغلِش إز إمپروڤِنغ سلولي"
    },
    {
      "id": "v2_s9",
      "en": "Please show me how to do it.",
      "ar": "من فضلك أرني كيف أفعلها.",
      "tr": "پليز شو مي هاو تو دو إت"
    },
    {
      "id": "v2_s10",
      "en": "I enjoy learning new words.",
      "ar": "أستمتع بتعلم كلمات جديدة.",
      "tr": "آي إنجوي لِرنِنغ نيو وِردز"
    }
  ]
