  "sentences": [
    {
      "id": "ev_s1",
      "en": "We must protect the environment.",
      "ar": "يجب أن نحمي البيئة.",
      "tr": "وي مَست پرُوتِكت ذي إنڤايرَنمِنت"
    },
    {
      "id": "ev_s2",
      "en": "Please don't throw rubbish here.",
      "ar": "من فضلك لا ترمِ النفايات هنا.",
      "tr": "پليز دونت ثرو رَبِش هير"
    },
    {
      "id": "ev_s3",
      "en": "The air is cleaner in the village.",
      "ar": "الهواء أنظف في القرية.",
      "tr": "ذي إير إز كلينَر إن ذَ ڤِلِج"
    },
    {
      "id": "ev_s4",
      "en": "We should save water.",
      "ar": "يجب أن نوفّر الماء.",
      "tr": "وي شود سيڤ ووتَر"
    },
    {
      "id": "ev_s5",
      "en": "I planted a tree in the garden.",
      "ar": "زرعت شجرة في الحديقة.",
      "tr": "آي پلانتِد إيه تري إن ذَ غاردِن"
    },
    {
      "id": "ev_s6",
      "en": "Pollution is a big problem.",
      "ar": "التلوث مشكلة كبيرة.",
      "tr": "پَلوشِن إز إيه بِغ پروبلِم"
    },
    {
      "id": "ev_s7",
      "en": "This bag can be recycled.",
      "ar": "هذا الكيس يمكن إعادة تدويره.",
      "tr": "ذِس باغ كان بي ريسايكِلد"
    },
    {
      "id": "ev_s8",
      "en": "I love walking in nature.",
      "ar": "أحب المشي في الطبيعة.",
      "tr": "آي لَڤ ووكِنغ إن نيتشَر"
    }
  ]
