  "sentences": [
    {
      "id": "oc_s1",
      "en": "Congratulations on your wedding!",
      "ar": "مبروك على زواجك!",
      "tr": "كَنغراتشُوليشِنز أون يور وِدِنغ"
    },
    {
      "id": "oc_s2",
      "en": "Happy birthday to you!",
      "ar": "عيد ميلاد سعيد!",
      "tr": "هابي بيرثديه تو يو"
    },
    {
      "id": "oc_s3",
      "en": "You are invited to my house.",
      "ar": "أنت مدعو إلى بيتي.",
      "tr": "يو آر إنڤايتِد تو ماي هاوس"
    },
    {
      "id": "oc_s4",
      "en": "We celebrate Eid with the family.",
      "ar": "نحتفل بالعيد مع العائلة.",
      "tr": "وي سِلِبريت عيد وِذ ذَ فامِلي"
    },
    {
      "id": "oc_s5",
      "en": "Thank you for the lovely gift.",
      "ar": "شكراً على الهدية الجميلة.",
      "tr": "ثانك يو فور ذَ لَڤلي غِفت"
    },
    {
      "id": "oc_s6",
      "en": "The party starts at eight.",
      "ar": "الحفلة تبدأ في الثامنة.",
      "tr": "ذَ پارتي ستارتس آت إيت"
    },
    {
      "id": "oc_s7",
      "en": "We are fasting in Ramadan.",
      "ar": "نصوم في رمضان.",
      "tr": "وي آر فاستِنغ إن رَمَضان"
    },
    {
      "id": "oc_s8",
      "en": "My sister's graduation is next month.",
      "ar": "تخرّج أختي الشهر القادم.",
      "tr": "ماي سِستَرز غراجُويشِن إز نِكست مَنث"
    },
    {
      "id": "oc_s9",
      "en": "Please accept my condolences.",
      "ar": "تقبّل تعازيّ.",
      "tr": "پليز أكسِپت ماي كَندولَنسِز"
    },
    {
      "id": "oc_s10",
      "en": "Best wishes to you and your family.",
      "ar": "أطيب التمنيات لك ولعائلتك.",
      "tr": "بِست وِشِز تو يو آند يور فامِلي"
    }
  ]
}
