  "sentences": [
    {
      "id": "ws_s1",
      "en": "Always wear your helmet here.",
      "ar": "ارتدِ الخوذة دائماً هنا.",
      "tr": "أولويز وير يور هِلمِت هير"
    },
    {
      "id": "ws_s2",
      "en": "The floor is slippery, be careful.",
      "ar": "الأرضية زلقة، انتبه.",
      "tr": "ذَ فلور إز سلِپَري، بي كيرفُل"
    },
    {
      "id": "ws_s3",
      "en": "Where is the emergency exit?",
      "ar": "أين مخرج الطوارئ؟",
      "tr": "وير إز ذي إميرجِنسي إكسِت"
    },
    {
      "id": "ws_s4",
      "en": "Switch off the machine first.",
      "ar": "أطفئ الآلة أولاً.",
      "tr": "سوِتش أوف ذَ مَشين فيرست"
    },
    {
      "id": "ws_s5",
      "en": "Report any accident immediately.",
      "ar": "بلّغ عن أي حادث فوراً.",
      "tr": "رِپورت إني آكسِدِنت إميديَتلي"
    },
    {
      "id": "ws_s6",
      "en": "This area is forbidden.",
      "ar": "هذه المنطقة ممنوعة.",
      "tr": "ذِس إيريا إز فَربِدِن"
    },
    {
      "id": "ws_s7",
      "en": "Don't lift that alone.",
      "ar": "لا ترفع ذلك وحدك.",
      "tr": "دونت لِفت ذات ألون"
    },
    {
      "id": "ws_s8",
      "en": "My shift starts at seven.",
      "ar": "ورديتي تبدأ في السابعة.",
      "tr": "ماي شِفت ستارتس آت سِڤِن"
    },
    {
      "id": "ws_s9",
      "en": "I feel unwell, can I rest?",
      "ar": "أشعر بتوعك، هل يمكنني الاستراحة؟",
      "tr": "آي فيل أنوِل، كان آي رِست"
    },
    {
      "id": "ws_s10",
      "en": "Safety is more important than speed.",
      "ar": "السلامة أهم من السرعة.",
      "tr": "سيفتي إز مور إمپورتَنت ذان سپيد"
    }
  ]
