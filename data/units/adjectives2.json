  "sentences": [
    {
      "id": "a2_s1",
      "en": "Is it possible to change the date?",
      "ar": "هل يمكن تغيير الموعد؟",
      "tr": "إز إت پوسِبِل تو تشينج ذَ ديت"
    },
    {
      "id": "a2_s2",
      "en": "This street is very crowded.",
      "ar": "هذا الشارع مزدحم جداً.",
      "tr": "ذِس ستريت إز ڤيري كراودِد"
    },
    {
      "id": "a2_s3",
      "en": "The chair is not comfortable.",
