  "sentences": [
    { "id": "pa_s1", "en": "I was at home yesterday.", "ar": "كنت في البيت أمس.", "tr": "آي واز آت هوم يِستَرديه" },
    { "id": "pa_s2", "en": "We went to the market last week.", "ar": "ذهبنا إلى السوق الأسبوع الماضي.", "tr": "وي وِنت تو ذَ ماركِت لاست ويك" },
    { "id": "pa_s3", "en": "She made a delicious dinner.", "ar": "أعدّت عشاءً لذيذاً.", "tr": "شي مِيد إيه دِليشَس دِنَر" },
    { "id": "pa_s4", "en": "I didn't sleep well last night.", "ar": "لم أنم جيداً الليلة الماضية.", "tr": "آي دِدنت سليپ وِل لاست نايت" },
    { "id": "pa_s5", "en": "He bought a new car two months ago.", "ar": "اشترى سيارة جديدة قبل شهرين.", "tr": "هي بوت إيه نيو كار تو مَنثس أغو" },
    { "id": "pa_s6", "en": "I met your brother at the mosque.", "ar": "قابلت أخاك في المسجد.", "tr": "آي مِت يور براذَر آت ذَ موسك" },
    { "id": "pa_s7", "en": "What did you do yesterday?", "ar": "ماذا فعلت أمس؟", "tr": "وات دِد يو دو يِستَرديه" },
    { "id": "pa_s8", "en": "I worked from nine to five.", "ar": "عملت من التاسعة إلى الخامسة.", "tr": "آي وِركت فروم ناين تو فايڤ" },
    { "id": "pa_s9", "en": "We had a very good time.", "ar": "قضينا وقتاً ممتعاً جداً.", "tr": "وي هاد إيه ڤيري غُود تايم" },
    { "id": "pa_s10", "en": "I lost my keys but I found them.", "ar": "فقدت مفاتيحي لكنني وجدتها.", "tr": "آي لوست ماي كيز بَت آي فاوند ذِم" },
    { "id": "pa_s11", "en": "They came late to the meeting.", "ar": "أتوا متأخرين إلى الاجتماع.", "tr": "ذيه كيم ليت تو ذَ ميتِنغ" },
    { "id": "pa_s12", "en": "I read that book last year.", "ar": "قرأت ذلك الكتاب العام الماضي.", "tr": "آي رِد ذات بوك لاست يِير" }
  ]
