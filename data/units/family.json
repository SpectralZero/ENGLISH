  "sentences": [
    {
      "id": "fa_s1",
      "en": "I have a big family.",
      "ar": "لدي عائلة كبيرة.",
      "tr": "آي هاڤ إيه بِغ فامِلي"
    },
    {
      "id": "fa_s2",
      "en": "My father is a driver.",
      "ar": "أبي سائق.",
      "tr": "ماي فاذَر إز إيه درايڤَر"
    },
    {
      "id": "fa_s3",
      "en": "My mother is at home.",
      "ar": "أمي في البيت.",
      "tr": "ماي مَذَر إز آت هوم"
    },
    {
      "id": "fa_s4",
      "en": "I have two brothers.",
      "ar": "لدي أخوان.",
      "tr": "آي هاڤ تو براذَرز"
    },
    {
      "id": "fa_s5",
      "en": "My sister is ten years old.",
      "ar": "أختي عمرها عشر سنوات.",
      "tr": "ماي سِستَر إز تِن يِيرز أولد"
    },
    {
      "id": "fa_s6",
      "en": "We live together.",
      "ar": "نحن نعيش معاً.",
      "tr": "وي لِڤ تُوغيذَر"
    },
    {
      "id": "fa_s7",
      "en": "This is my wife.",
      "ar": "هذه زوجتي.",
      "tr": "ذِس إز ماي وايف"
    },
    {
      "id": "fa_s8",
      "en": "Do you have children?",
      "ar": "هل لديك أطفال؟",
      "tr": "دو يو هاڤ تشِلدرِن"
    },
    {
      "id": "fa_s9",
      "en": "My grandfather is old.",
      "ar": "جدي كبير في السن.",
      "tr": "ماي غراندفاذَر إز أولد"
    },
    {
      "id": "fa_s10",
      "en": "I love my family very much.",
      "ar": "أحب عائلتي كثيراً.",
      "tr": "آي لَڤ ماي فامِلي ڤيري مَتش"
    },
    {
      "id": "fa_s11",
      "en": "My family lives in the same city.",
      "ar": "عائلتي تسكن في نفس المدينة.",
      "tr": "ماي فامِلي لِڤز إن ذَ سيم سِتي"
    },
    {
      "id": "fa_s12",
      "en": "My son goes to school.",
      "ar": "ابني يذهب إلى المدرسة.",
      "tr": "ماي سَن غوز تو سكوول"
    },
    {
      "id": "fa_s13",
      "en": "My daughter is very clever.",
      "ar": "ابنتي ذكية جداً.",
      "tr": "ماي دوتَر إز ڤيري كليڤَر"
    },
    {
      "id": "fa_s14",
      "en": "We visit our parents every week.",
      "ar": "نزور والدينا كل أسبوع.",
      "tr": "وي ڤِزِت أوَر پيرِنتس إڤري ويك"
    },
    {
      "id": "fa_s15",
      "en": "How many people are in your family?",
      "ar": "كم فرداً في عائلتك؟",
      "tr": "هاو مِني پيپل آر إن يور فامِلي"
    },
    {
      "id": "fa_s16",
      "en": "My uncle lives in another city.",
      "ar": "عمي يسكن في مدينة أخرى.",
      "tr": "ماي أنكِل لِڤز إن أناذَر سِتي"
    },
    {
      "id": "fa_s17",
      "en": "My grandmother cooks very well.",
      "ar": "جدتي تطبخ بشكل ممتاز.",
      "tr": "ماي غراندمَذَر كوكس ڤيري وِل"
    },
    {
      "id": "fa_s18",
      "en": "We eat dinner together every night.",
      "ar": "نتناول العشاء معاً كل ليلة.",
      "tr": "وي إيت دِنَر تُوغيذَر إڤري نايت"
    },
    {
      "id": "fa_s19",
      "en": "He is like a brother to me.",
      "ar": "هو مثل أخ لي.",
      "tr": "هي إز لايك إيه براذَر تو مي"
    },
    {
      "id": "fa_s20",
      "en": "Family is everything.",
      "ar": "العائلة هي كل شيء.",
      "tr": "فامِلي إز إڤريثِنغ"
    }
  ]
}
