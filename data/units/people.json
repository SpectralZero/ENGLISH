  "sentences": [
    {
      "id": "pe_s1",
      "en": "I am a teacher.",
      "ar": "أنا معلّم.",
      "tr": "آي آم إيه تيتشَر"
    },
    {
      "id": "pe_s2",
      "en": "You are very kind.",
      "ar": "أنت لطيف جداً.",
      "tr": "يو آر ڤيري كايند"
    },
    {
      "id": "pe_s3",
      "en": "He is my brother.",
      "ar": "هو أخي.",
      "tr": "هي إز ماي براذَر"
    },
    {
      "id": "pe_s4",
      "en": "She is a good student.",
      "ar": "هي طالبة جيدة.",
      "tr": "شي إز إيه غُود ستيودِنت"
    },
    {
      "id": "pe_s5",
      "en": "We are from Morocco.",
      "ar": "نحن من المغرب.",
      "tr": "وي آر فروم مورَكو"
    },
    {
      "id": "pe_s6",
      "en": "They are my neighbors.",
      "ar": "هم جيراني.",
      "tr": "ذيه آر ماي نيبَرز"
    },
    {
      "id": "pe_s7",
      "en": "This is my house.",
      "ar": "هذا بيتي.",
      "tr": "ذِس إز ماي هاوس"
    },
    {
      "id": "pe_s8",
      "en": "That man is my father.",
      "ar": "ذلك الرجل هو أبي.",
      "tr": "ذات مان إز ماي فاذَر"
    },
    {
      "id": "pe_s9",
      "en": "The children are happy.",
      "ar": "الأطفال سعداء.",
      "tr": "ذَ تشِلدرِن آر هابي"
    },
    {
      "id": "pe_s10",
      "en": "Her name is Nour.",
      "ar": "اسمها نور.",
      "tr": "هير نيم إز نور"
    },
    {
      "id": "pe_s11",
      "en": "He is a kind person.",
      "ar": "هو شخص طيب.",
      "tr": "هي إز إيه كايند پيرسِن"
    },
    {
      "id": "pe_s12",
      "en": "She is my best friend.",
      "ar": "هي أفضل صديقة لي.",
      "tr": "شي إز ماي بِست فرِند"
    },
    {
      "id": "pe_s13",
      "en": "They live near us.",
      "ar": "هم يسكنون قربنا.",
      "tr": "ذيه لِڤ نير أَس"
    },
    {
      "id": "pe_s14",
      "en": "We are students here.",
      "ar": "نحن طلاب هنا.",
      "tr": "وي آر ستيودِنتس هير"
    },
    {
      "id": "pe_s15",
      "en": "This is his car.",
      "ar": "هذه سيارته.",
      "tr": "ذِس إز هِز كار"
    },
    {
      "id": "pe_s16",
      "en": "That is her bag.",
      "ar": "تلك حقيبتها.",
      "tr": "ذات إز هير باغ"
    },
    {
      "id": "pe_s17",
      "en": "Those children are ours.",
      "ar": "أولئك الأطفال أطفالنا.",
      "tr": "ذوز تشِلدرِن آر أوَرز"
    },
    {
      "id": "pe_s18",
      "en": "Everyone is waiting outside.",
      "ar": "الجميع ينتظر في الخارج.",
      "tr": "إڤريوان إز ويتِنغ أوتسايد"
    },
    {
      "id": "pe_s19",
      "en": "The man over there is my uncle.",
      "ar": "الرجل هناك هو عمي.",
      "tr": "ذَ مان أوڤَر ذير إز ماي أنكِل"
    },
    {
      "id": "pe_s20",
      "en": "I know that woman.",
      "ar": "أعرف تلك المرأة.",
      "tr": "آي نو ذات وُومَن"
    }
  ]
}
