  "sentences": [
    {
      "id": "qt_s1",
      "en": "I need a bottle of water.",
      "ar": "أحتاج زجاجة ماء.",
      "tr": "آي نيد إيه بوتِل أوڤ ووتَر"
    },
    {
      "id": "qt_s2",
      "en": "Give me half a kilo, please.",
      "ar": "أعطني نصف كيلو من فضلك.",
      "tr": "غِڤ مي هاف إيه كيلو، پليز"
    },
    {
      "id": "qt_s3",
      "en": "That is too much sugar.",
      "ar": "هذا سكر أكثر من اللازم.",
      "tr": "ذات إز تو مَتش شُوغَر"
    },
    {
      "id": "qt_s4",
      "en": "We have enough bread for today.",
      "ar": "لدينا خبز كافٍ لليوم.",
      "tr": "وي هاڤ إينَف برِد فور تُوديه"
    },
    {
      "id": "qt_s5",
      "en": "I bought a packet of rice.",
      "ar": "اشتريت كيس أرز.",
      "tr": "آي بوت إيه پاكِت أوڤ رايس"
    },
    {
      "id": "qt_s6",
      "en": "How much does it weigh?",
      "ar": "كم يزن؟",
      "tr": "هاو مَتش دَز إت ويه"
    },
    {
      "id": "qt_s7",
      "en": "I want two pieces only.",
      "ar": "أريد قطعتين فقط.",
      "tr": "آي وانت تو پيسِز أونلي"
    },
    {
      "id": "qt_s8",
      "en": "The bottle is empty.",
      "ar": "الزجاجة فارغة.",
      "tr": "ذَ بوتِل إز إمپتي"
    },
    {
      "id": "qt_s9",
      "en": "Can I have a little more?",
      "ar": "هل يمكنني الحصول على المزيد قليلاً؟",
      "tr": "كان آي هاڤ إيه لِتِل مور"
    },
    {
      "id": "qt_s10",
      "en": "They cost five each.",
      "ar": "ثمن الواحدة خمسة.",
      "tr": "ذيه كوست فايڤ إيتش"
    }
  ]
