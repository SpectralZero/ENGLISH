  "sentences": [
    {
      "id": "ph_s1",
      "en": "What is your phone number?",
      "ar": "ما رقم هاتفك؟",
      "tr": "وات إز يور فون نَمبَر"
    },
    {
      "id": "ph_s2",
      "en": "Please call me tomorrow.",
      "ar": "من فضلك اتصل بي غداً.",
      "tr": "پليز كول مي تُومورو"
    },
    {
      "id": "ph_s3",
      "en": "I will send you a message.",
      "ar": "سأرسل لك رسالة.",
      "tr": "آي وِل سِند يو إيه مِسِج"
    },
    {
      "id": "ph_s4",
      "en": "Is there Wi-Fi here?",
      "ar": "هل يوجد واي فاي هنا؟",
      "tr": "إز ذير واي فاي هير"
    },
    {
      "id": "ph_s5",
      "en": "What is the password?",
      "ar": "ما كلمة السر؟",
      "tr": "وات إز ذَ پاسوِرد"
    },
    {
      "id": "ph_s6",
      "en": "My phone battery is low.",
      "ar": "بطارية هاتفي منخفضة.",
      "tr": "ماي فون باتَري إز لو"
    },
    {
      "id": "ph_s7",
      "en": "Can I borrow your charger?",
      "ar": "هل يمكنني استعارة شاحنك؟",
      "tr": "كان آي بورو يور تشارجَر"
    },
    {
      "id": "ph_s8",
      "en": "The internet is very slow today.",
      "ar": "الإنترنت بطيء جداً اليوم.",
      "tr": "ذي إنتَرنِت إز ڤيري سلو تُوديه"
    },
    {
      "id": "ph_s9",
      "en": "I don't have your email.",
      "ar": "ليس لدي بريدك الإلكتروني.",
      "tr": "آي دونت هاڤ يور إيميل"
    },
    {
      "id": "ph_s10",
      "en": "Send me the picture, please.",
      "ar": "أرسل لي الصورة من فضلك.",
      "tr": "سِند مي ذَ پِكتشَر، پليز"
    },
    {
      "id": "ph_s11",
      "en": "Sorry, I can't hear you well.",
      "ar": "آسف، لا أسمعك جيداً.",
      "tr": "سوري، آي كانت هير يو وِل"
    },
    {
      "id": "ph_s12",
      "en": "The line is bad here.",
      "ar": "الشبكة ضعيفة هنا.",
      "tr": "ذَ لاين إز باد هير"
    },
    {
      "id": "ph_s13",
      "en": "I will send you the location.",
      "ar": "سأرسل لك الموقع.",
      "tr": "آي وِل سِند يو ذَ لُوكيشِن"
    },
    {
      "id": "ph_s14",
      "en": "My phone is switched off.",
      "ar": "هاتفي مغلق.",
      "tr": "ماي فون إز سوِتشد أوف"
    },
    {
      "id": "ph_s15",
      "en": "Add me on WhatsApp.",
      "ar": "أضفني على واتساب.",
      "tr": "آد مي أون واتسآپ"
    },
    {
      "id": "ph_s16",
      "en": "I didn't get your message.",
      "ar": "لم تصلني رسالتك.",
      "tr": "آي دِدنت غِت يور مِسِج"
    },
    {
      "id": "ph_s17",
      "en": "Can you connect to the Wi-Fi?",
      "ar": "هل يمكنك الاتصال بالواي فاي؟",
      "tr": "كان يو كَنِكت تو ذَ واي فاي"
    },
    {
      "id": "ph_s18",
      "en": "I need to charge my phone.",
      "ar": "أحتاج لشحن هاتفي.",
      "tr": "آي نيد تو تشارج ماي فون"
    }
  ]
}
