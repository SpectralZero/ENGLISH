    {
      "id": "ve_s1",
      "en": "I want to go home.",
      "ar": "أريد أن أذهب إلى البيت.",
      "tr": "آي وانت تو غو هوم"
    },
    {
      "id": "ve_s2",
      "en": "Can you help me, please?",
      "ar": "هل يمكنك مساعدتي من فضلك؟",
      "tr": "كان يو هِلپ مي، پليز"
    },
    {
      "id": "ve_s3",
      "en": "I don't know this word.",
      "ar": "لا أعرف هذه الكلمة.",
      "tr": "آي دونت نو ذِس وِرد"
    },
    {
      "id": "ve_s4",
      "en": "She works in a hospital.",
      "ar": "هي تعمل في مستشفى.",
      "tr": "شي وِركس إن إيه هوسپِتَل"
    },
    {
      "id": "ve_s5",
      "en": "We eat dinner at eight.",
      "ar": "نتناول العشاء في الثامنة.",
      "tr": "وي إيت دِنَر آت إيت"
    },
    {
      "id": "ve_s6",
      "en": "Please wait here.",
      "ar": "من فضلك انتظر هنا.",
      "tr": "پليز ويت هير"
    },
    {
      "id": "ve_s7",
      "en": "I must go now.",
      "ar": "يجب أن أذهب الآن.",
      "tr": "آي مَست غو ناو"
    },
    {
      "id": "ve_s8",
      "en": "He can drive a car.",
      "ar": "هو يستطيع قيادة السيارة.",
      "tr": "هي كان درايڤ إيه كار"
    },
    {
      "id": "ve_s9",
      "en": "I like to read books.",
      "ar": "أحب قراءة الكتب.",
      "tr": "آي لايك تو ريد بوكس"
    },
    {
      "id": "ve_s10",
      "en": "Call me tomorrow, please.",
      "ar": "اتصل بي غداً من فضلك.",
      "tr": "كول مي تُومورو، پليز"
    },
    {
      "id": "ve_s11",
      "en": "I am trying to learn.",
      "ar": "أنا أحاول أن أتعلم.",
      "tr": "آيم ترايِنغ تو ليرن"
    },
    {
      "id": "ve_s12",
      "en": "Where do you work?",
      "ar": "أين تعمل؟",
      "tr": "وير دو يو وِرك"
    },
    {
      "id": "ve_s13",
      "en": "Please give me a moment.",
      "ar": "من فضلك أمهلني لحظة.",
      "tr": "پليز غِڤ مي إيه مومِنت"
    },
    {
      "id": "ve_s14",
      "en": "I need to find my keys.",
      "ar": "أحتاج أن أجد مفاتيحي.",
      "tr": "آي نيد تو فايند ماي كيز"
    },
    {
      "id": "ve_s15",
      "en": "Can you bring me the book?",
      "ar": "هل يمكنك إحضار الكتاب لي؟",
      "tr": "كان يو برِنغ مي ذَ بوك"
    },
    {
      "id": "ve_s16",
      "en": "He is making tea now.",
      "ar": "هو يعدّ الشاي الآن.",
      "tr": "هي إز ميكِنغ تي ناو"
    },
    {
      "id": "ve_s17",
      "en": "Don't put it there.",
      "ar": "لا تضعه هناك.",
      "tr": "دونت پوت إت ذير"
    },
    {
      "id": "ve_s18",
      "en": "I want to learn how to drive.",
      "ar": "أريد أن أتعلم القيادة.",
      "tr": "آي وانت تو ليرن هاو تو درايڤ"
    },
    {
      "id": "ve_s19",
      "en": "She knows the answer.",
      "ar": "هي تعرف الإجابة.",
      "tr": "شي نوز ذي آنسَر"
    },
    {
      "id": "ve_s20",
      "en": "We must leave now.",
      "ar": "يجب أن نغادر الآن.",
      "tr": "وي مَست ليڤ ناو"
    },
    {
      "id": "ve_s21",
      "en": "Let me help you with that.",
      "ar": "دعني أساعدك في ذلك.",
      "tr": "لِت مي هِلپ يو وِذ ذات"
    },
    {
      "id": "ve_s22",
      "en": "I use this every day.",
      "ar": "أستخدم هذا كل يوم.",
      "tr": "آي يوز ذِس إڤري ديه"
    },
    {
      "id": "ve_s23",
      "en": "Tell me what happened.",
      "ar": "أخبرني بما حدث.",
      "tr": "تِل مي وات هاپِند"
    },
    {
      "id": "ve_s24",
      "en": "I will send it tonight.",
      "ar": "سأرسله الليلة.",
      "tr": "آي وِل سِند إت تُونايت"
    }
